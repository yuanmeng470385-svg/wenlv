<view class="page">
  <!-- 身份类型 -->
  <view class="sech" style="margin:8rpx 0 20rpx">
    <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">选择身份类型</view>
    <view class="sech-line"></view>
  </view>
  <view class="cat-row">
    <view wx:for="{{categories}}" wx:key="type"
      class="cd cat {{categoryType === item.type ? 'cat-on' : ''}}"
      data-type="{{item.type}}" bindtap="onSelectCategory">
      <view class="cat-gl serif">{{item.glyph}}</view>
      <view class="cat-lb">{{item.label}}</view>
      <view class="cat-sub">{{item.desc}}</view>
      <view class="cat-check" wx:if="{{categoryType === item.type}}"><icon name="check" size="26rpx" color="#FBF8F0" /></view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="sech" style="margin:32rpx 0 20rpx">
    <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">基本信息</view>
    <view class="sech-line"></view>
  </view>
  <view class="cd form-card">
    <view class="form-row">
      <text class="form-lb">名称</text>
      <input class="form-in" placeholder="名称 / 店名" placeholder-class="form-ph" value="{{name}}" data-field="name" bindinput="onInputChange" />
    </view>
    <view wx:if="{{categoryType === 'hanfu_shop'}}" class="form-row">
      <text class="form-lb">所在城市</text>
      <input class="form-in" placeholder="如：西安" placeholder-class="form-ph" value="{{city}}" data-field="city" bindinput="onInputChange" />
    </view>
    <view class="form-row">
      <text class="form-lb">联系电话</text>
      <input class="form-in" type="number" placeholder="请输入联系电话" placeholder-class="form-ph" value="{{phone}}" data-field="phone" bindinput="onInputChange" />
    </view>
    <view class="form-row form-row-top">
      <text class="form-lb">简介</text>
      <textarea class="form-ta" placeholder="介绍一下你的服务和特色" placeholder-class="form-ph" value="{{description}}" data-field="description" bindinput="onInputChange" />
    </view>
    <view class="form-row">
      <text class="form-lb">特色标签</text>
      <input class="form-in" placeholder="逗号分隔，如：古风,汉服,夜景" placeholder-class="form-ph" value="{{featureTags}}" data-field="featureTags" bindinput="onInputChange" />
    </view>
  </view>

  <!-- 头像 -->
  <view class="sech" style="margin:32rpx 0 20rpx">
    <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">商家头像</view>
    <view class="sech-line"></view>
    <text class="up-hint">1 张 · 必填</text>
  </view>
  <view class="up-row">
    <view wx:if="{{avatar}}" class="up-item up-round" bindtap="onUploadAvatar">
      <image src="{{avatar}}" mode="aspectFill" class="up-img up-round" />
      <view class="up-re">更换</view>
    </view>
    <view wx:else class="up-btn up-round" bindtap="onUploadAvatar">
      <icon name="plus" size="44rpx" color="#A79E8F" />
      <text class="up-btn-t">头像</text>
    </view>
    <view class="up-tip">圆形展示于店铺顶部，建议使用清晰正面图</view>
  </view>

  <!-- 背景图 -->
  <view class="sech" style="margin:32rpx 0 20rpx">
    <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">背景图</view>
    <view class="sech-line"></view>
    <text class="up-hint">1 张 · 必填 · 建议 750×400</text>
  </view>
  <view class="up-row">
    <view wx:if="{{backgroundImage}}" class="up-item up-wide" bindtap="onUploadBackground">
      <image src="{{backgroundImage}}" mode="aspectFill" class="up-img" />
      <view class="up-re">更换</view>
    </view>
    <view wx:else class="up-btn up-wide" bindtap="onUploadBackground">
      <icon name="img" size="48rpx" color="#A79E8F" />
      <text class="up-btn-t">上传背景图</text>
    </view>
  </view>

  <!-- 代表作品 -->
  <view class="sech" style="margin:32rpx 0 20rpx">
    <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">代表作品</view>
    <view class="sech-line"></view>
    <text class="up-hint">最多 9 张</text>
  </view>
  <view class="up-grid">
    <view wx:for="{{portfolioImages}}" wx:key="*this" class="up-item">
      <image src="{{item}}" mode="aspectFill" class="up-img" />
    </view>
    <view wx:if="{{portfolioImages.length < 9}}" class="up-btn" bindtap="onUploadPortfolio">
      <icon name="plus" size="44rpx" color="#A79E8F" />
    </view>
  </view>

  <view class="reg-submit safe-bottom">
    <button class="btn btn-red btn-lg btn-block" bindtap="onSubmit" loading="{{submitting}}">提交入驻审核</button>
    <view class="reg-note">提交后管理员将在 1-3 个工作日内完成审核</view>
  </view>
</view>
