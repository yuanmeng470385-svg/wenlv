/* ========== 汉服店位置 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }

/* ---- 位置卡 ---- */
.loc-card { display: flex; align-items: center; padding: 26rpx 28rpx; }
.loc-pin {
  width: 72rpx; height: 72rpx; border-radius: 50%; flex: none;
  background: rgba(190, 63, 44, 0.08); border: 1rpx solid rgba(190, 63, 44, 0.18);
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.loc-city { font-size: 30rpx; font-weight: 500; letter-spacing: 1rpx; }
.loc-sub { font-size: 22rpx; color: var(--ink-3); margin-top: 4rpx; }
.loc-re { padding: 12rpx 0 12rpx 20rpx; }

/* ---- 定位中 ---- */
.locating { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; gap: 20rpx; }
.locating-t { font-size: 26rpx; color: var(--ink-3); letter-spacing: 2rpx; }

/* ---- 分段 ---- */
.seg-row { display: flex; gap: 16rpx; margin-top: 28rpx; }

/* ---- 入驻店卡 ---- */
.shop { display: flex; padding: 24rpx; margin-top: 20rpx; }
.shop:active { opacity: 0.92; }
.shop-cover { width: 160rpx; height: 180rpx; border-radius: var(--radius-md); flex: none; }
.shop-info { flex: 1; min-width: 0; margin-left: 24rpx; display: flex; flex-direction: column; }
.shop-name-row { display: flex; align-items: center; gap: 12rpx; }
.shop-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; max-width: 320rpx; }
.stars { display: flex; align-items: center; gap: 6rpx; margin-top: 8rpx; }
.stars-n { font-size: 26rpx; font-weight: 700; }
.stars-c { font-size: 22rpx; color: var(--ink-3); }
.shop-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 12rpx; }

/* ---- 周边店卡 ---- */
.shop-ext { background: transparent; border: 1rpx dashed var(--line); box-shadow: none; }
.shop-ext-ic {
  width: 160rpx; height: 180rpx; border-radius: var(--radius-md); flex: none;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center;
}
.shop-name-ext { font-size: 30rpx; }
.shop-addr { margin-top: 8rpx; max-width: 380rpx; }
.ext-note { text-align: center; font-size: 20rpx; color: var(--ink-3); letter-spacing: 2rpx; margin-top: 32rpx; }

.state { text-align: center; padding: 80rpx 0; color: var(--ink-3); font-size: 26rpx; }
