/* ========== 作品详情 v3「纸墨朱砂」 ========== */
.page-pf { min-height: 100vh; padding-bottom: 140rpx; }
.pf-sw { width: 100%; height: 720rpx; }
.pf-img { width: 100%; height: 100%; }
.pf-info { margin: -40rpx 32rpx 0; padding: 32rpx 28rpx; position: relative; z-index: 2; }
.pf-title { font-size: 40rpx; font-weight: 900; letter-spacing: 2rpx; }
.pf-desc { font-size: 26rpx; color: var(--ink-2); line-height: 1.8; margin-top: 14rpx; }
.pf-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 20rpx; }
.pf-meta { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; }
.pf-meta-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--ink-2); }
.pf-action { position: fixed; bottom: 0; left: 0; right: 0; justify-content: space-around; z-index: 10; }
.pf-act { display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 4rpx 40rpx; }
.pf-act-n { font-size: 22rpx; color: var(--ink-2); }
.pf-act-on .pf-act-n { color: var(--red); }
