.page-review { padding: 20rpx; background: var(--bg-page); min-height: 100vh; }
.review-card { margin-bottom: 20rpx; }
.img-compare { display: flex; gap: 20rpx; }
.img-col { flex: 1; }
.review-img { width: 100%; height: 200rpx; border-radius: 12rpx; margin-top: 10rpx; }
.action-btns { display: flex; gap: 16rpx; justify-content: flex-end; }
.btn-reject { background: var(--bg-page); color: var(--text-hint); border: 1rpx solid var(--border-color); font-size: 26rpx; padding: 12rpx 32rpx; border-radius: 8rpx; }
.btn-pass { background: var(--color-primary); color: #fff; font-size: 26rpx; padding: 12rpx 32rpx; border-radius: 8rpx; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.empty-hint { padding: 120rpx 0; text-align: center; }
