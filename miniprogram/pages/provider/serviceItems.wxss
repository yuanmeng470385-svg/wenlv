/* ========== 套餐管理 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.si-top { margin-bottom: 4rpx; }

.si-hint {
  display: flex; align-items: center; gap: 10rpx;
  background: rgba(176, 141, 87, 0.1); border: 1rpx solid rgba(176, 141, 87, 0.28);
  border-radius: var(--radius-md); padding: 18rpx 24rpx; margin-top: 20rpx;
}
.si-hint-t { font-size: 22rpx; color: var(--gold-deep); }

.si-card { margin-top: 20rpx; padding: 24rpx 24rpx 16rpx; }
.si-card-rej { border-color: rgba(190, 63, 44, 0.3); }
.si-main { display: flex; align-items: center; }
.si-ic { width: 84rpx; height: 84rpx; border-radius: var(--radius-md); flex: none; margin-right: 20rpx; }
.si-ic-ph { background: var(--paper-2); border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; }
.si-name-row { display: flex; align-items: center; gap: 12rpx; }
.si-name { font-size: 30rpx; font-weight: 500; max-width: 300rpx; }
.si-meta { margin-top: 8rpx; display: flex; align-items: baseline; }
.si-meta-t { font-size: 20rpx; color: var(--ink-3); }
.si-rej { margin-top: 10rpx; font-size: 20rpx; color: var(--red); }
.si-hr { margin: 18rpx 0 10rpx; }
.si-ops { display: flex; align-items: center; justify-content: space-between; min-height: 52rpx; }
.si-ops-r { display: flex; gap: 8rpx; }
