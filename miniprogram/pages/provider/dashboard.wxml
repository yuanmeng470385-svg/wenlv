<view class="page-dashboard">
  <view class="stats-grid">
    <view class="stat-item"><text class="stat-num">{{stats.todayOrders}}</text><text class="stat-label">今日订单</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.pendingOrders}}</text><text class="stat-label">待处理</text></view>
    <view class="stat-item"><text class="stat-num">{{stats.totalOrders}}</text><text class="stat-label">总订单</text></view>
    <view class="stat-item"><text class="stat-num">¥{{stats.totalIncome}}</text><text class="stat-label">总收入</text></view>
  </view>

  <view class="quick-actions">
    <view class="action-card" bindtap="goUploadWork"><view class="icon-row"><icon name="upload" size="40rpx" /><text>上传作品</text></view></view>
    <view class="action-card" bindtap="goMyWorks"><view class="icon-row"><icon name="photo" size="40rpx" /><text>作品管理</text></view></view>
    <view class="action-card" bindtap="goSchedule"><view class="icon-row"><icon name="calendar" size="40rpx" /><text>档期管理</text></view></view>
    <view class="action-card" bindtap="goEditProfile"><view class="icon-row"><icon name="edit" size="40rpx" /><text>编辑资料</text></view></view>
  </view>

  <view class="section card"><text class="text-bold text-lg">最近订单</text>
    <view wx:for="{{recentOrders}}" wx:key="_id" class="order-row" data-id="{{item._id}}" bindtap="goOrderDetail">
      <text>{{item.orderNo}}</text><text class="text-price">¥{{item.totalFee / 100}}</text>
    </view>
    <view wx:if="{{!recentOrders.length}}" class="empty-hint"><text class="text-secondary">暂无订单</text></view>
  </view>
</view>
