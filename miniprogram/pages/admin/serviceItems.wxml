<view class="page">
  <view wx:if="{{loading}}" class="adm-state">加载中…</view>
  <empty-state wx:elif="{{!list.length}}" text="暂无待审核套餐" icon="order" />

  <view wx:for="{{list}}" wx:key="_id" class="cd rv-card" data-id="{{item._id}}" bindtap="onCardTap">
    <view class="rv-head">
      <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFill" class="rv-thumb" />
      <view wx:else class="rv-thumb rv-thumb-ph"><icon name="order" size="44rpx" color="#A79E8F" /></view>
      <view class="flex-1">
        <view class="rv-name-row">
          <text class="rv-name serif text-ellipsis">{{item.name}}</text>
          <text class="tag">{{item._typeLabel}}</text>
        </view>
        <view class="text-hint text-sm" style="margin-top:6rpx">服务商：{{item.providerName}}</view>
        <view class="rv-price-row">
          <view class="price" style="font-size:32rpx"><text class="price-sym">¥</text>{{item.price/100}}</view>
          <text class="text-hint text-sm"> · {{item.duration}}分钟 · 每日限 {{item.maxDailyBooking || 5}} 单</text>
        </view>
      </view>
    </view>
    <view wx:if="{{item.description}}" class="rv-desc">{{item.description}}</view>
    <view class="rv-ops">
      <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" data-action="rejected" catchtap="onAction">驳回</button>
      <button class="btn btn-ink btn-md rv-pass" data-id="{{item._id}}" data-action="approved" catchtap="onAction"><icon name="check" size="28rpx" color="#FBF8F0" />通过上架</button>
    </view>
  </view>
</view>
