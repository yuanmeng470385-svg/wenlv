<view class="page">
  <view class="mw-grid">
    <!-- 上传入口 -->
    <view class="mw-upload" bindtap="goUpload">
      <icon name="upload" size="56rpx" color="#A79E8F" />
      <text class="mw-upload-t">上传作品</text>
    </view>

    <view wx:for="{{works}}" wx:key="_id" class="mw-item">
      <image src="{{item.images[0]}}" mode="aspectFill" class="mw-img" />
      <text class="st {{item._statusClass}} mw-st">{{item._statusLabel}}</text>
      <view wx:if="{{item.status === 'approved' || item.status === 'rejected'}}" class="mw-del" catchtap="onDelete" data-id="{{item._id}}">
        <icon name="trash" size="24rpx" color="#F6F1E7" />
      </view>
      <view class="mw-likes">
        <icon name="heart-filled" size="22rpx" color="#F6F1E7" />
        <text class="mw-likes-n">{{item.likeCount || 0}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!works.length}}" text="暂无作品，去上传吧" icon="img" />
  <view class="mw-note" wx:if="{{works.length}}">删除作品无需审核 · 新作品发布后需管理员审核</view>
</view>
