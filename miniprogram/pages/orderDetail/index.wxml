<view class="page" wx:if="{{order}}">
  <!-- 状态头 -->
  <view class="od-head">
    <text class="st {{order._statusClass}} od-status">{{order.statusText}}</text>
    <view class="od-no serif">{{order.orderNo}}</view>
  </view>

  <!-- 服务项目 -->
  <view class="cd sec">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">服务项目</view>
      <view class="sech-line"></view>
    </view>
    <view wx:for="{{order.items}}" wx:key="serviceItemId" class="od-item">
      <view class="flex-between">
        <text class="text-bold">{{item.name}}</text>
        <view class="price" style="font-size:30rpx"><text class="price-sym">¥</text>{{item.price / 100}}<text class="price-q" wx:if="{{item.quantity > 1}}"> ×{{item.quantity}}</text></view>
      </view>
      <view class="text-sm text-hint od-item-sub">{{item.appointmentDate}} {{item.appointmentTime}} · 时长 {{item.duration}} 分钟</view>
      <view wx:if="{{item.providerDeleted}}" class="st st-gray" style="margin-top:10rpx">商家已注销</view>
    </view>
  </view>

  <!-- 服务商 -->
  <view class="cd sec" wx:if="{{providers.length}}">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">服务商</view>
      <view class="sech-line"></view>
    </view>
    <view wx:for="{{providers}}" wx:key="_id" class="lrow od-prov">
      <view class="od-prov-ic"><icon name="store" size="36rpx" color="#43615C" /></view>
      <view class="lrow-t">
        <text>{{item.name}}</text>
        <text wx:if="{{item.providerDeleted}}" class="st st-gray" style="margin-left:10rpx">已注销</text>
      </view>
      <view class="od-call" catchtap="onCallProvider" data-id="{{item._id}}">
        <icon name="phone" size="30rpx" color="#43615C" /><text class="od-call-t">拨打</text>
      </view>
    </view>
  </view>

  <!-- 联系信息 -->
  <view class="cd sec">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">联系信息</view>
      <view class="sech-line"></view>
    </view>
    <view class="lrow"><text class="od-k">联系人</text><view class="lrow-t">{{order.contactName}}</view></view>
    <view class="lrow">
      <text class="od-k">手机号</text>
      <view class="lrow-t">{{order.contactPhone}}</view>
      <view class="od-call" catchtap="onCallCustomer">
        <icon name="phone" size="30rpx" color="#43615C" /><text class="od-call-t">拨打</text>
      </view>
    </view>
    <view class="lrow" wx:if="{{order.remark}}"><text class="od-k">备注</text><view class="lrow-t">{{order.remark}}</view></view>
  </view>

  <!-- 费用明细 -->
  <view class="cd sec">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">费用明细</view>
      <view class="sech-line"></view>
    </view>
    <view class="lrow">
      <text class="od-k">总金额</text>
      <view class="lrow-t"></view>
      <view class="price" style="font-size:40rpx"><text class="price-sym">¥</text>{{order.totalFee / 100}}</view>
    </view>
    <view class="lrow" wx:if="{{order.refundAmount > 0}}">
      <text class="od-k">退款金额</text>
      <view class="lrow-t"></view>
      <text class="text-price text-bold">¥{{order.refundAmount / 100}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="actionbar od-action">
    <block wx:if="{{order.orderStatus === 'pending_pay'}}">
      <button class="btn btn-txt btn-md" bindtap="onCancelOrder">取消订单</button>
      <button wx:if="{{isAdmin}}" class="btn btn-line btn-md" bindtap="onMockPay">模拟支付</button>
      <button class="btn btn-red btn-lg flex-1" bindtap="onPay">去支付 ¥{{order.totalFee / 100}}</button>
    </block>
    <block wx:elif="{{order.orderStatus === 'paid'}}">
      <button class="btn btn-txt btn-md" bindtap="onCancelOrder">取消订单</button>
      <view class="flex-1 od-wait">等待商家接单…</view>
    </block>
    <button wx:elif="{{order.orderStatus === 'completed'}}" class="btn btn-ink btn-lg btn-block" bindtap="onReview">评价本次服务</button>
  </view>
</view>
