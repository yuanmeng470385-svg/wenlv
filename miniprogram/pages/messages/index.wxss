/* ========== 消息 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.unread-bar { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 0; }
.msg { display: flex; padding: 26rpx 28rpx; margin-top: 20rpx; }
.msg:active { opacity: 0.9; }
.msg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--red); flex: none; margin: 14rpx 20rpx 0 0; }
.msg-dot-read { background: transparent; }
.msg-title { font-size: 28rpx; font-weight: 700; }
.msg-title-read { color: var(--ink-3); font-weight: 400; }
.msg-body { font-size: 24rpx; color: var(--ink-2); margin-top: 10rpx; line-height: 1.7; }
