<view class="page-profile">
  <!-- 用户头部 -->
  <view class="user-header">
    <view class="user-avatar {{hasLogin ? 'avatar-editable' : ''}}" bindtap="{{hasLogin ? 'onChangeAvatar' : ''}}">
      <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <text wx:else class="avt-ph">我</text>
      <view wx:if="{{hasLogin}}" class="avatar-edit-mask">
        <text class="avatar-edit-icon">📷</text>
      </view>
    </view>
    <text class="user-name text-xl text-bold">{{displayName}}</text>
    <text class="user-role">{{roleLabel}}</text>
    <button wx:if="{{!hasLogin}}" class="login-btn-sm" open-type="getUserInfo" bindgetuserinfo="onGetUserInfo">登录</button>
  </view>

  <!-- 身份切换 -->
  <view wx:if="{{hasLogin && roles.length > 1}}" class="role-section card">
    <text class="section-title text-sm text-secondary">切换身份</text>
    <view class="role-list">
      <view wx:for="{{roleList}}" wx:key="key"
        class="role-chip {{activeRole === item.key ? 'active' : ''}}"
        data-role="{{item.key}}" bindtap="onSwitchRole">
        <text>{{item.icon}} {{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 管理模式 -->
  <block wx:if="{{isAdminMode}}">
    <view class="menu-section">
      <view class="menu-item flex-between" bindtap="onExitAdmin"><text>退出管理模式</text><text class="text-secondary">></text></view>
    </view>
  </block>

  <!-- 用户模式菜单 -->
  <block wx:elif="{{activeRole === 'user'}}">
    <view wx:if="{{hasLogin}}" class="menu-card card" bindtap="onApplyProvider">
      <view class="flex-between"><text>申请成为服务商</text><text class="text-secondary">></text></view>
    </view>
    <view class="menu-section">
      <view wx:for="{{menuItems}}" wx:key="label" class="menu-item flex-between" data-url="{{item.url}}" bindtap="onMenuTap">
        <text>{{item.icon}} {{item.label}}</text><text class="text-secondary">></text>
      </view>
    </view>
  </block>

  <!-- 商家模式菜单 -->
  <block wx:else>
    <view class="menu-section">
      <view class="menu-item flex-between" data-url="/pages/messages/index" bindtap="onMenuTap"><text>🔔 消息通知</text><text class="text-secondary">></text></view>
      <view class="menu-item flex-between" bindtap="onDeregister"><text>⚠️ 注销商家身份</text><text class="text-secondary">></text></view>
    </view>
  </block>

  <view wx:if="{{hasLogin && !isAdminMode}}" class="menu-section safe-bottom">
    <view class="menu-item flex-between" bindtap="onAdminLogin"><text>🔐 管理员登录</text><text class="text-secondary">></text></view>
    <view class="menu-item flex-between" bindtap="onLogout"><text>🚪 退出登录</text><text class="text-secondary">></text></view>
  </view>
</view>
