<view class="page">
  <view wx:if="{{loading}}" class="adm-state">加载中…</view>
  <empty-state wx:elif="{{!list.length}}" text="暂无待审核作品" icon="img" />

  <view wx:for="{{list}}" wx:key="_id" class="cd rv-card" data-id="{{item._id}}" bindtap="onCardTap">
    <view class="rv-head">
      <image wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" class="rv-thumb" />
      <view wx:else class="rv-thumb rv-thumb-ph"><icon name="img" size="48rpx" color="#A79E8F" /></view>
      <view class="flex-1">
        <view class="rv-name serif">{{item.title}}</view>
        <view class="text-hint text-sm" style="margin-top:6rpx">服务商：{{item.providerName}}</view>
        <view wx:if="{{item.styleTags && item.styleTags.length}}" class="rv-tags">
          <text class="tag" wx:for="{{item.styleTags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{item.description}}" class="rv-desc">{{item.description}}</view>
    <view class="rv-ops">
      <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" data-action="rejected" catchtap="onAction">驳回</button>
      <button class="btn btn-ink btn-md rv-pass" data-id="{{item._id}}" data-action="approved" catchtap="onAction"><icon name="check" size="28rpx" color="#FBF8F0" />通过发布</button>
    </view>
  </view>
</view>
