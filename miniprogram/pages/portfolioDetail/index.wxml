<view class="page-pf" wx:if="{{portfolio}}">
  <swiper class="pf-sw" bindchange="onSwiperChange" indicator-dots indicator-color="rgba(246,241,231,0.35)" indicator-active-color="#F6F1E7">
    <swiper-item wx:for="{{portfolio.images}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="pf-img" data-url="{{item}}" bindtap="onPreviewImage" />
    </swiper-item>
  </swiper>

  <view class="cd pf-info">
    <view class="pf-title serif">{{portfolio.title}}</view>
    <view class="pf-desc">{{portfolio.description}}</view>

    <view wx:if="{{portfolio.styleTags && portfolio.styleTags.length}}" class="pf-tags">
      <text class="tag" wx:for="{{portfolio.styleTags}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="hr" style="margin:24rpx 0"></view>
    <view class="pf-meta">
      <view wx:if="{{portfolio.shootDate}}" class="pf-meta-item"><icon name="cal" size="30rpx" color="#6E675C" /><text>{{portfolio.shootDate}}</text></view>
      <view wx:if="{{portfolio.shootLocation}}" class="pf-meta-item"><icon name="pin" size="30rpx" color="#6E675C" /><text>{{portfolio.shootLocation}}</text></view>
      <view wx:if="{{portfolio.makeupDuration}}" class="pf-meta-item"><icon name="clock" size="30rpx" color="#6E675C" /><text>妆造 {{portfolio.makeupDuration}} 分钟</text></view>
      <view wx:if="{{portfolio.hanfuType}}" class="pf-meta-item"><icon name="robe" size="30rpx" color="#6E675C" /><text>{{portfolio.hanfuType}}</text></view>
    </view>
  </view>

  <view class="actionbar pf-action">
    <view class="pf-act {{isLiked ? 'pf-act-on' : ''}}" bindtap="onLike">
      <icon wx:if="{{isLiked}}" name="heart-filled" size="44rpx" color="#BE3F2C" />
      <icon wx:else name="heart" size="44rpx" color="#29241D" />
      <text class="pf-act-n">{{portfolio.likeCount || 0}}</text>
    </view>
    <view class="pf-act {{isFavorited ? 'pf-act-on' : ''}}" bindtap="onFavorite">
      <icon wx:if="{{isFavorited}}" name="bmk" size="44rpx" color="#BE3F2C" />
      <icon wx:else name="bmk" size="44rpx" color="#29241D" />
      <text class="pf-act-n">收藏</text>
    </view>
  </view>
</view>
