/* 位置栏 */
.location-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #C48B5C 0%, #B07A4E 100%);
  color: #fff;
}
.loc-left {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  flex: 1;
}
.loc-icon { margin-right: 8rpx; }
.loc-city { font-weight: 600; max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.loc-arrow { margin-left: 6rpx; font-size: 24rpx; opacity: 0.8; }
.loc-btn {
  padding: 10rpx 24rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 30rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 分区 */
.section { margin: 0 20rpx 10rpx; }
.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.section-icon { margin-right: 8rpx; }
.section-title { color: #333; }
.section-count { color: #999; font-size: 24rpx; margin-left: 8rpx; font-weight: 400; }
.section-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #C48B5C;
  border: 1rpx solid #C48B5C;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-weight: 400;
}

/* 商家卡片 */
.shop-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.shop-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.shop-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: #F5F0EA;
}
.shop-info { flex: 1; overflow: hidden; }
.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}
.shop-city {
  font-size: 24rpx;
  color: #C48B5C;
  margin-bottom: 4rpx;
}
.shop-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}
.shop-meta { font-size: 22rpx; color: #999; display: flex; gap: 16rpx; }
.shop-rating { color: #E8A735; }
.shop-arrow { color: #ccc; font-size: 36rpx; }
.shop-cat { font-size: 20rpx; color: #C48B5C; }

/* 拨号按钮 */
.call-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  background: #C48B5C;
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 状态 */
.state-loading { text-align: center; padding: 60rpx 0; color: #999; font-size: 28rpx; }
.state-empty { text-align: center; padding: 60rpx 0; color: #ccc; font-size: 26rpx; }
