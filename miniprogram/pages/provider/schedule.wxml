<view class="page-schedule">
  <scroll-view scroll-x class="date-bar">
    <text wx:for="{{dateList}}" wx:key="date"
      class="date-item {{selectedDate===item.date?'active':''}}"
      data-date="{{item.date}}" data-label="{{item.label}}" bindtap="onSelectDate">{{item.label}}</text>
  </scroll-view>

  <view wx:if="{{selectedDate}}" class="slot-section">
    <view class="flex-between p-20">
      <text class="text-bold text-lg">{{selectedLabel}}</text>
      <view class="batch-btns">
        <button class="batch-btn on" data-action="all_on" bindtap="onBatchAction">全天开启</button>
        <button class="batch-btn off" data-action="all_off" bindtap="onBatchAction">全天关闭</button>
      </view>
    </view>

    <view class="slot-grid">
      <view wx:for="{{timeSlots}}" wx:key="time"
        class="slot-card {{item.available ? 'open' : 'closed'}}"
        data-time="{{item.time}}" bindtap="onToggleSlot">
        <text class="slot-time">{{item.time}}</text>
        <text class="slot-status">{{item.available ? '可预约' : '已关闭'}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-hint"><text class="text-secondary">请先选择日期</text></view>
</view>
