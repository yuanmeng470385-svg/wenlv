.page-list { min-height: 100vh; background: var(--bg-page); }
.category-scroll { background: var(--bg-white); white-space: nowrap; }
.cat-list { display: inline-flex; padding: 20rpx; }
.cat-item { padding: 14rpx 28rpx; font-size: 28rpx; border-radius: 30rpx; margin: 0 10rpx; color: var(--text-secondary); }
.cat-item.active { background: var(--color-primary); color: #fff; }

.search-bar { background: #fff; padding: 0 20rpx 16rpx; position: relative; }
.search-input { width: 100%; height: 64rpx; background: #F5F5F5; border-radius: 32rpx; padding: 0 60rpx 0 30rpx; font-size: 26rpx; box-sizing: border-box; }
.search-clear { position: absolute; right: 36rpx; top: 16rpx; font-size: 28rpx; color: #999; padding: 4rpx; }

.filter-bar { background: var(--bg-white); padding: 0 20rpx 16rpx; }
.level-scroll { flex: 1; white-space: nowrap; }
.level-item { display: inline-block; padding: 10rpx 22rpx; font-size: 24rpx; border-radius: 20rpx; margin-right: 12rpx; border: 1rpx solid var(--border-color); color: var(--text-secondary); }
.level-item.active { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-bg); }

.sort-bar { background: var(--bg-white); border-top: 1rpx solid var(--border-color); }
.sort-item { padding: 8rpx 20rpx; font-size: 26rpx; color: var(--text-secondary); margin-left: 10rpx; }
.sort-item.active { color: var(--color-primary); font-weight: 600; }

.provider-list { padding: 10rpx 0; }
.provider-card { margin: 0 20rpx 16rpx; }
.p-avatar { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; background: var(--bg-page); }
.p-name { max-width: 300rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.feature-tag { padding: 6rpx 16rpx; font-size: 22rpx; border-radius: 8rpx; background: var(--color-primary-bg); color: var(--color-primary); }

.level-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 20rpx; margin-left: 10rpx; color: #fff; }
.level-1 { background: var(--level-bronze); }
.level-2 { background: var(--level-silver); color: #333; }
.level-3 { background: var(--level-gold); color: #333; }
.level-4 { background: var(--level-platinum); }
.level-5 { background: var(--level-diamond); }

.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.px-20 { padding-left: 20rpx; padding-right: 20rpx; }
.py-20 { padding-top: 20rpx; padding-bottom: 20rpx; }

.empty-hint { padding: 120rpx 0; text-align: center; }
