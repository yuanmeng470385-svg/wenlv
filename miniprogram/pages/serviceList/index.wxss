/* ========== 服务列表 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }

/* ---- 搜索 ---- */
.srch {
  height: 72rpx; border-radius: var(--radius-pill);
  background: var(--card); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; padding: 0 24rpx; gap: 12rpx;
}
.srch-input { flex: 1; font-size: 26rpx; color: var(--ink); }
.srch-phc { color: var(--ink-3); }
.srch-clear { padding: 8rpx; }

/* ---- 品类/排序 ---- */
.chips-scroll { width: 100%; margin-top: 20rpx; }
.chips-row { display: flex; padding-right: 32rpx; }
.chips-row .chip { flex: none; margin-right: 16rpx; }
.sort-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 0 4rpx; }
.sort-ops { display: flex; gap: 20rpx; }
.sort-item { font-size: 24rpx; color: var(--ink-3); }
.sort-item.on { color: var(--red); font-weight: 500; }

/* ---- 商家大卡 ---- */
.plist { margin-top: 24rpx; }
.pcard { overflow: hidden; margin-bottom: 24rpx; }
.pcard:active { opacity: 0.92; }
.pcard-cover { width: 100%; height: 284rpx; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
.pcard-body { padding: 24rpx 28rpx 28rpx; }
.pcard-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; max-width: 440rpx; }
.stars { display: flex; align-items: center; gap: 6rpx; }
.stars-n { font-size: 28rpx; font-weight: 700; }
.pcard-tags { display: flex; gap: 10rpx; margin-top: 14rpx; flex-wrap: wrap; }
.pcard-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
