/* ========== 首页 v3「纸墨朱砂」 ========== */
.page { padding: 0 32rpx 40rpx; }

/* ---- 顶栏：搜索 + 消息 ---- */
.topbar { display: flex; align-items: center; padding: 16rpx 0 4rpx; }
.srch {
  flex: 1; height: 72rpx; border-radius: var(--radius-pill);
  background: var(--card); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; padding: 0 28rpx; gap: 12rpx;
}
.srch-ph { font-size: 26rpx; color: var(--ink-3); }
.bell { position: relative; margin-left: 24rpx; padding: 8rpx; }
.bell-dot {
  position: absolute; top: 8rpx; right: 10rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--red); border: 3rpx solid var(--paper);
}

/* ---- 主视觉 ---- */
.hero-sw { height: 316rpx; margin-top: 20rpx; border-radius: 36rpx; overflow: hidden; }
.hero { position: relative; width: 100%; height: 100%; border-radius: 36rpx; overflow: hidden; }
.hero-single { height: 316rpx; margin-top: 20rpx; }
.hero-img, .hero-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-mask { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,20,15,0) 30%, rgba(23,20,15,0.55) 100%); }
.hero-seal {
  position: absolute; top: 28rpx; left: 32rpx;
  width: 64rpx; height: 64rpx; border-radius: 16rpx;
  background: var(--red); color: #FFF6EC;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx; font-weight: 700;
  box-shadow: 0 8rpx 28rpx -8rpx rgba(190, 63, 44, 0.5);
}
.hero-vt {
  position: absolute; top: 28rpx; right: 32rpx;
  writing-mode: vertical-rl; font-size: 22rpx; letter-spacing: 12rpx;
  color: rgba(246, 241, 231, 0.6);
}
.hero-title {
  position: absolute; left: 32rpx; bottom: 28rpx; right: 120rpx;
  font-size: 44rpx; font-weight: 900; letter-spacing: 4rpx; line-height: 1.4;
  color: #F6F1E7; text-shadow: 0 2rpx 12rpx rgba(23, 20, 15, 0.4);
}

/* ---- 品类三卡 ---- */
.cat-row { display: flex; margin: 28rpx 0 0; }
.cat {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 28rpx 0 24rpx; margin-right: 20rpx;
}
.cat:last-child { margin-right: 0; }
.cat:active { opacity: 0.85; }
.cat-gl { font-size: 52rpx; font-weight: 900; line-height: 1.1; }
.cat-lb { font-size: 26rpx; font-weight: 500; letter-spacing: 2rpx; margin-top: 12rpx; }
.cat-sub { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; letter-spacing: 1rpx; }

/* ---- 节间距 ---- */
.sec-gap { margin: 40rpx 0 24rpx; }

/* ---- 甄选作品横滑 ---- */
.works-scroll { width: 100%; }
.works-row { display: flex; padding-right: 32rpx; }
.wcard { width: 240rpx; flex: none; margin-right: 24rpx; }
.wcard-img { width: 240rpx; height: 300rpx; border-radius: var(--radius-md); }
.wcard-gl { font-size: 76rpx; }
.wcard-name { margin-top: 14rpx; font-size: 26rpx; font-weight: 500; letter-spacing: 1rpx; }
.wcard-sub { margin-top: 4rpx; font-size: 20rpx; color: var(--ink-3); }

/* ---- 推荐商家行 ---- */
.prow { display: flex; align-items: center; padding: 24rpx; margin-bottom: 20rpx; }
.prow:active { opacity: 0.9; }
.prow-cover { width: 160rpx; height: 180rpx; border-radius: var(--radius-md); flex: none; }
.prow-info { flex: 1; min-width: 0; margin: 0 20rpx; display: flex; flex-direction: column; }
.prow-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; }
.stars { display: flex; align-items: center; margin-top: 8rpx; gap: 6rpx; }
.stars-n { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.stars-c { font-size: 22rpx; color: var(--ink-3); }
.prow-tags { display: flex; gap: 10rpx; margin-top: 10rpx; }
.prow-foot { margin-top: 10rpx; }

/* ========== 商家模式 ========== */
.page-p { padding-bottom: 40rpx; }
.cover { width: 100%; height: 400rpx; position: relative; }
.cover-img { width: 100%; height: 100%; border-radius: 0; }
.cover-edit {
  position: absolute; top: 24rpx; right: 24rpx;
  display: flex; align-items: center; gap: 8rpx;
  background: rgba(23, 20, 15, 0.4); border-radius: var(--radius-pill);
  padding: 12rpx 22rpx;
}
.cover-edit-t { color: #F6F1E7; font-size: 22rpx; }
.p-head { display: flex; padding: 0 32rpx; margin-top: -56rpx; position: relative; z-index: 2; }
.p-avt-wrap { position: relative; flex: none; }
.p-avt { width: 124rpx; height: 124rpx; border-radius: 50%; border: 6rpx solid var(--paper); }
.p-avt-edit {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--ink); border: 4rpx solid var(--paper);
  display: flex; align-items: center; justify-content: center;
}
.p-head-info { padding-top: 64rpx; margin-left: 24rpx; }
.p-name { font-size: 42rpx; font-weight: 900; letter-spacing: 2rpx; }
.p-sub { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.p-tags { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 20rpx 32rpx 0; }

.ptabs { display: flex; margin: 32rpx 32rpx 0; border-bottom: 1rpx solid var(--line-2); }
.ptab { padding: 0 0 18rpx; margin-right: 48rpx; font-size: 30rpx; color: var(--ink-3); border-bottom: 4rpx solid transparent; }
.ptab.on { color: var(--ink); border-bottom-color: var(--red); font-weight: 700; }
.p-content { padding: 24rpx 32rpx 0; }

.svc { display: flex; align-items: center; padding: 24rpx; margin-bottom: 20rpx; }
.svc-icon { width: 84rpx; height: 84rpx; border-radius: var(--radius-md); flex: none; margin-right: 24rpx; }
.svc-icon-ph { background: var(--paper-2); border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; }
.svc-right { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
.svc-st { margin-top: 8rpx; }
.p-note { text-align: center; font-size: 20rpx; color: var(--ink-3); letter-spacing: 2rpx; padding: 24rpx 0 8rpx; }

.work-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.work-item { width: 49%; position: relative; border-radius: var(--radius-md); overflow: hidden; margin-bottom: 16rpx; }
.work-img { width: 100%; height: 300rpx; }
.work-overlay {
  position: absolute; bottom: 0; left: 0; right: 0; padding: 32rpx 20rpx 16rpx;
  background: linear-gradient(transparent, rgba(23, 20, 15, 0.65)); color: #F6F1E7;
}
.work-title { display: block; font-size: 24rpx; margin-bottom: 6rpx; }
.work-likes { display: flex; align-items: center; gap: 6rpx; }
.work-likes-n { font-size: 22rpx; }

.review { padding: 24rpx; margin-bottom: 20rpx; }

/* ========== 管理员模式 ========== */
.adm-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 4rpx 8rpx; }
.adm-title { font-size: 40rpx; font-weight: 900; letter-spacing: 4rpx; }
.sec { margin-top: 28rpx; padding: 28rpx 0 8rpx; }
.sec .sech { padding: 0 28rpx; }
.banner-row { padding: 24rpx 28rpx; }
.banner-thumb { width: 120rpx; height: 72rpx; border-radius: var(--radius-sm); flex: none; }
.banner-thumb-ph {
  width: 120rpx; height: 72rpx; border-radius: var(--radius-sm); flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--paper-2); border: 1rpx dashed var(--line);
}
.banner-ops { display: flex; gap: 8rpx; }
.sec .lrow { padding: 24rpx 28rpx; margin: 0; }
.sec .lrow + .lrow { border-top: 1rpx solid var(--line-2); }
