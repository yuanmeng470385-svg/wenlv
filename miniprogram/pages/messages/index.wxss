.page-messages { min-height: 100vh; background: var(--bg-page); padding: 20rpx; }
.msg-card { position: relative; margin: 0 0 12rpx; }
.unread { color: var(--text-primary); }
.unread-dot { position: absolute; top: 24rpx; right: 24rpx; width: 16rpx; height: 16rpx; background: #FF4D4F; border-radius: 50%; }
.empty-hint { padding: 120rpx 0; text-align: center; }
.mt-10 { margin-top: 10rpx; }
