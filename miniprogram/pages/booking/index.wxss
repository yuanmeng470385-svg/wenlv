/* ========== 预约下单 v3「纸墨朱砂」 ========== */
.page-bk { min-height: 100vh; padding-bottom: 140rpx; }

/* ---- 步骤条 ---- */
.steps { display: flex; align-items: center; padding: 28rpx 48rpx 8rpx; }
.stp { display: flex; flex-direction: column; align-items: center; flex: none; }
.stp-dot {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  border: 2rpx solid var(--line); background: var(--paper-2);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: var(--ink-3);
}
.stp-lb { font-size: 20rpx; color: var(--ink-3); margin-top: 8rpx; }
.stp.done .stp-dot { background: var(--ink); border-color: var(--ink); color: #FBF8F0; }
.stp.done .stp-lb { color: var(--ink); }
.stp.cur .stp-dot { background: var(--red); border-color: var(--red); color: #FFF6EC; box-shadow: 0 0 0 8rpx rgba(190, 63, 44, 0.12); }
.stp.cur .stp-lb { color: var(--red); font-weight: 500; }
.stp-ln { flex: 1; height: 2rpx; background: var(--line); margin: 0 16rpx 36rpx; }
.stp-ln.done { background: var(--ink); }

.bk-content { padding: 16rpx 32rpx 0; }

/* ---- 服务卡 ---- */
.svc { display: flex; align-items: center; padding: 24rpx; margin-bottom: 20rpx; }
.svc:active { opacity: 0.9; }
.svc-ic {
  width: 76rpx; height: 76rpx; border-radius: var(--radius-md); flex: none;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
}
.svc-right { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
.svc-add { margin-top: 10rpx; }
.cart-item { display: flex; align-items: center; padding: 24rpx; margin-bottom: 16rpx; }

/* ---- 时间卡 ---- */
.time-card { padding: 28rpx; margin-bottom: 24rpx; }
.date-scroll { margin-top: 20rpx; }
.date-row { display: flex; }
.date-pill {
  width: 128rpx; flex: none; margin-right: 16rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 0; border-radius: var(--radius-md);
  border: 1rpx solid var(--line); background: var(--card);
}
.date-pill.on { background: var(--ink); border-color: var(--ink); }
.date-pill.on .date-week, .date-pill.on .date-day { color: #FBF8F0; }
.date-week { font-size: 20rpx; color: var(--ink-3); }
.date-day { font-size: 28rpx; font-weight: 700; color: var(--ink); margin-top: 4rpx; }
.slot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.slot { width: 31%; justify-content: center; height: 68rpx; box-sizing: border-box; }
.hours-row { margin-top: 24rpx; }
.hours-slider { margin-top: 8rpx; }

/* ---- 确认 ---- */
.confirm-card { padding: 28rpx; }
.confirm-item { display: flex; align-items: center; padding: 12rpx 0; }
.confirm-total { margin-top: 24rpx; }

.bk-action { position: fixed; bottom: 0; left: 0; right: 0; gap: 20rpx; z-index: 10; }
