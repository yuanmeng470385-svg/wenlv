.page-dashboard { min-height: 100vh; background: var(--bg-page); padding: 20rpx; }
.stats-grid { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.stat-item { flex: 1; background: var(--bg-white); border-radius: var(--radius-md); padding: 30rpx 10rpx; text-align: center; }
.stat-num { display: block; font-size: 36rpx; font-weight: 700; color: var(--color-primary); }
.stat-label { display: block; font-size: 22rpx; color: var(--text-secondary); margin-top: 8rpx; }
.quick-actions { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.action-card { flex: 1; background: var(--bg-white); border-radius: var(--radius-md); padding: 30rpx 10rpx; text-align: center; font-size: 24rpx; color: var(--text-primary); }
.section { margin: 0 0 20rpx; }
.order-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--border-color); display: flex; justify-content: space-between; }
.empty-hint { padding: 40rpx 0; text-align: center; }
.icon-row { display: flex; align-items: center; gap: 4rpx; }
