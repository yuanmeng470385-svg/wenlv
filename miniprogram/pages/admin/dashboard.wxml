<view class="page-admin">
  <view class="admin-header"><view class="icon-row"><icon name="wrench" size="36rpx" /><text>管理中心</text></view></view>

  <view class="stats-grid">
    <view class="stat-card warn" bindtap="goProviders">
      <text class="stat-num">{{stats.pendingProviders||0}}</text><text class="stat-label">待审服务商</text>
    </view>
    <view class="stat-card warn" bindtap="goPortfolios">
      <text class="stat-num">{{stats.pendingPortfolios||0}}</text><text class="stat-label">待审作品</text>
    </view>
    <view class="stat-card warn" bindtap="goServiceItems">
      <text class="stat-num">{{stats.pendingServiceItems||0}}</text><text class="stat-label">待审套餐</text>
    </view>
    <view class="stat-card warn" bindtap="goRefunds">
      <text class="stat-num">{{stats.pendingRefunds||0}}</text><text class="stat-label">待审退款</text>
    </view>
    <view class="stat-card warn" bindtap="goAvatarUpdates">
      <text class="stat-num">{{stats.pendingAvatarUpdates||0}}</text><text class="stat-label">待审头像/背景</text>
    </view>
    <view class="stat-card warn" bindtap="goDeregistrations">
      <text class="stat-num">{{stats.pendingDeregistrations||0}}</text><text class="stat-label">待审注销</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item flex-between" bindtap="goProviders"><view class="icon-row"><icon name="shop" size="36rpx" /><text>服务商入驻审核</text></view><icon name="chevron-right" size="28rpx" /></view>
    <view class="menu-item flex-between" bindtap="goServiceItems"><view class="icon-row"><icon name="package" size="36rpx" /><text>套餐审核</text></view><icon name="chevron-right" size="28rpx" /></view>
    <view class="menu-item flex-between" bindtap="goPortfolios"><view class="icon-row"><icon name="photo" size="36rpx" /><text>作品审核</text></view><icon name="chevron-right" size="28rpx" /></view>
    <view class="menu-item flex-between" bindtap="goRefunds"><view class="icon-row"><icon name="money" size="36rpx" /><text>退款审核</text></view><icon name="chevron-right" size="28rpx" /></view>
    <view class="menu-item flex-between" bindtap="goAvatarUpdates"><view class="icon-row"><icon name="photo" size="36rpx" /><text>头像/背景图修改审核</text></view><icon name="chevron-right" size="28rpx" /></view>
    <view class="menu-item flex-between" bindtap="goDeregistrations"><view class="icon-row"><icon name="warning" size="36rpx" /><text>商家注销审核</text></view><icon name="chevron-right" size="28rpx" /></view>
  </view>

  <view class="menu-section mt-20">
    <view class="menu-item flex-between" bindtap="goUsers"><view class="icon-row"><icon name="user" size="36rpx" /><text>用户管理</text></view><icon name="chevron-right" size="28rpx" /></view>
  </view>
</view>
