.page-orders { min-height: 100vh; background: var(--bg-page); }
.admin-review-center { padding: 0; }
.admin-header-sm { background: linear-gradient(135deg, #2D1B69, #1A0F3C); padding: 40rpx 30rpx; color: #fff; font-size: 32rpx; font-weight: 700; }
.review-menu { background: var(--bg-white); margin: 20rpx; border-radius: 16rpx; overflow: hidden; }
.review-menu-item { padding: 28rpx 30rpx; border-bottom: 1rpx solid var(--bg-page); }
.review-menu-item:last-child { border-bottom: none; }
.tab-scroll { background: var(--bg-white); white-space: nowrap; }
.tab-list { display: inline-flex; padding: 10rpx 20rpx; }
.tab-item { display: inline-block; padding: 14rpx 24rpx; font-size: 24rpx; color: var(--text-secondary); border-radius: 30rpx; margin: 0 6rpx; }
.tab-item.active { color: var(--color-primary); background: var(--color-primary-bg); font-weight: 600; }
.order-card { margin: 0 20rpx 16rpx; }
.order-item { padding: 8rpx 0; }
.status-text { font-weight: 600; color: var(--color-price); }
.pt-20 { border-top: 1rpx solid var(--border-color); padding-top: 12rpx; }
.action-btns { display: flex; justify-content: flex-end; gap: 12rpx; }
.btn-confirm { padding: 12rpx 28rpx; font-size: 24rpx; background: var(--color-primary); color: #fff; border-radius: 30rpx; }
.btn-refuse { padding: 12rpx 28rpx; font-size: 24rpx; background: var(--bg-page); color: var(--text-hint); border-radius: 30rpx; }
.dash-top { background: var(--bg-page); padding-top: 10rpx; }
.stats-row { display: flex; gap: 12rpx; padding: 0 20rpx 10rpx; }
.stat-card { flex: 1; background: var(--bg-white); border-radius: 16rpx; padding: 24rpx 16rpx; text-align: center; box-shadow: var(--shadow-card); }
.stat-num { display: block; font-size: 40rpx; font-weight: 700; color: var(--text-primary); }
.stat-num.highlight { color: var(--color-price); }
.stat-label { display: block; font-size: 22rpx; color: var(--text-hint); margin-top: 6rpx; }
.quick-row { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 20rpx; margin-bottom: 16rpx; }
.quick-item { flex: 1 1 calc(33.33% - 12rpx); min-width: 160rpx; background: var(--bg-white); border-radius: 16rpx; padding: 24rpx 10rpx; text-align: center; box-shadow: var(--shadow-card); }
.quick-icon { display: block; font-size: 44rpx; margin-bottom: 8rpx; }
.quick-label { font-size: 24rpx; color: var(--text-secondary); }
.empty-hint { padding: 120rpx 0; text-align: center; }
.mb-10 { margin-bottom: 10rpx; } .mb-20 { margin-bottom: 20rpx; } .mt-10 { margin-top: 10rpx; } .mt-20 { margin-top: 20rpx; }
