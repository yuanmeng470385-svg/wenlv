/* Shimmer animation */
@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.shimmer-block {
  position: relative;
  overflow: hidden;
  background: #F0EDE8;
  border-radius: 16rpx;
}

.shimmer-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.6) 50%,
    transparent 100%
  );
  animation: shimmer 1.5s ease-in-out infinite;
}

/* Card type */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 24rpx;
}

.card-item {
  width: calc(50% - 12rpx);
}

.card-image {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
}

/* List type */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.list-content {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-line {
  height: 28rpx;
  border-radius: 8rpx;
}

.list-line-long {
  width: 70%;
}

.list-line-short {
  width: 40%;
}

/* Detail type */
.detail-banner {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.detail-line {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.detail-line-long {
  width: calc(100% - 64rpx);
}

.detail-line-mid {
  width: 60%;
}

.detail-line-short {
  width: 35%;
}

/* Banner type */
.banner-block {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
}
