<view class="page">
  <view wx:if="{{loading}}" class="adm-state">加载中…</view>
  <empty-state wx:elif="{{!list.length}}" text="暂无待审核服务商" icon="store" />

  <view wx:for="{{list}}" wx:key="_id" class="cd rv-card" data-id="{{item._id}}" bindtap="onCardTap">
    <!-- 头部 -->
    <view class="rv-head">
      <image wx:if="{{item.avatar}}" class="rv-avt" src="{{item.avatar}}" mode="aspectFill" />
      <view wx:else class="rv-avt avt {{item._grad}}" style="width:96rpx;height:96rpx;font-size:38rpx">{{item._glyph}}</view>
      <view class="flex-1">
        <view class="rv-name-row">
          <text class="rv-name serif text-ellipsis">{{item.name}}</text>
          <text class="tag">{{item._typeLabel}}</text>
        </view>
        <view class="text-hint text-sm" style="margin-top:6rpx">申请于 {{item.createTime}}</view>
      </view>
    </view>

    <view class="hr" style="margin:20rpx 0"></view>

    <!-- 信息 -->
    <view class="rv-grid">
      <text class="rv-k">联系电话</text><text class="rv-v">{{item.phone || '未填写'}}</text>
      <text class="rv-k">所在城市</text><text class="rv-v">{{item.city || '未填写'}}</text>
    </view>
    <view wx:if="{{item.featureTags && item.featureTags.length}}" class="rv-tags">
      <text class="tag" wx:for="{{item.featureTags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
    </view>
    <view wx:if="{{item.description}}" class="rv-desc">{{item.description}}</view>

    <!-- 图片 -->
    <scroll-view wx:if="{{item.images && item.images.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="rv-imgs">
      <image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="rv-img" data-url="{{item}}" data-urls="{{item.images}}" catchtap="previewImage" />
    </scroll-view>

    <!-- 操作 -->
    <view class="rv-ops">
      <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" catchtap="onReject">驳回</button>
      <button class="btn btn-ink btn-md rv-pass" data-id="{{item._id}}" catchtap="onPass"><icon name="check" size="28rpx" color="#FBF8F0" />通过入驻</button>
    </view>
  </view>
</view>
