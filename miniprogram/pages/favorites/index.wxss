/* ========== 收藏 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.seg-row { display: flex; gap: 16rpx; }
.fav { display: flex; align-items: center; padding: 24rpx; margin-top: 20rpx; }
.fav:active { opacity: 0.9; }
.fav-thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-md); flex: none; }
.fav-ph { background: var(--paper-2); border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; }
.fav-info { flex: 1; min-width: 0; margin: 0 24rpx; }
.fav-name { font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.fav-desc { margin-top: 6rpx; }
.stars { display: flex; align-items: center; gap: 6rpx; margin-top: 8rpx; }
.stars-n { font-size: 26rpx; font-weight: 700; }
