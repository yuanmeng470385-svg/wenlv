/* ========== 我的 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }

/* ---- 用户头部 ---- */
.u-head { display: flex; align-items: center; padding: 32rpx 28rpx; }
.u-avt-wrap { position: relative; flex: none; margin-right: 28rpx; }
.u-avt { width: 112rpx; height: 112rpx; border-radius: 50%; }
.u-avt-edit {
  position: absolute; right: -4rpx; bottom: -4rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--ink); border: 4rpx solid var(--card);
  display: flex; align-items: center; justify-content: center;
}
.u-name { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; }
.u-sub { display: flex; align-items: center; margin-top: 10rpx; }

/* ---- 身份切换 ---- */
.u-roles { margin-top: 24rpx; padding: 24rpx 28rpx; }
.u-roles-head { display: flex; align-items: center; gap: 16rpx; }
.u-roles-lb { font-size: 22rpx; color: var(--ink-3); letter-spacing: 2rpx; flex: none; }
.u-roles-tip { font-size: 20rpx; color: var(--ink-3); flex: none; }
.u-roles-row { display: flex; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }

/* ---- 菜单组 ---- */
.menu { margin-top: 24rpx; padding: 4rpx 28rpx; }
.menu .lrow { padding: 26rpx 0; }
.mi {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; flex: none;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
}
.mi-gold { background: rgba(176, 141, 87, 0.1); border-color: rgba(176, 141, 87, 0.25); }
.mi-red { background: rgba(190, 63, 44, 0.07); border-color: rgba(190, 63, 44, 0.18); }
