/* ========== 商家入驻 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 60rpx; min-height: 100vh; }

/* ---- 身份三卡 ---- */
.cat-row { display: flex; }
.cat { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; padding: 28rpx 0 24rpx; margin-right: 16rpx; }
.cat:last-child { margin-right: 0; }
.cat-on { border-color: var(--ink); box-shadow: 0 0 0 2rpx var(--ink), var(--shadow-card); }
.cat-gl { font-size: 52rpx; font-weight: 900; color: var(--ink); }
.cat-lb { font-size: 26rpx; font-weight: 500; margin-top: 12rpx; }
.cat-sub { font-size: 18rpx; color: var(--ink-3); margin-top: 4rpx; }
.cat-check {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--ink); border: 3rpx solid var(--paper);
  display: flex; align-items: center; justify-content: center;
}

/* ---- 表单/上传（全局 .form-* .up-*） ---- */
.up-grid, .up-row { padding: 0 4rpx; }

.reg-submit { margin-top: 48rpx; }
.reg-note { text-align: center; font-size: 20rpx; color: var(--ink-3); letter-spacing: 1rpx; margin-top: 20rpx; }
