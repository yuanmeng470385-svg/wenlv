/* ========== 作品管理 v3「纸墨朱砂」 ========== */
.page { padding: 24rpx 32rpx 40rpx; min-height: 100vh; }
.mw-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.mw-upload {
  width: 49%; height: 300rpx; margin-bottom: 16rpx;
  border: 2rpx dashed var(--line); border-radius: var(--radius-md);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx;
  box-sizing: border-box;
}
.mw-upload:active { background: var(--paper-2); }
.mw-upload-t { font-size: 24rpx; color: var(--ink-3); }
.mw-item { width: 49%; position: relative; margin-bottom: 16rpx; border-radius: var(--radius-md); overflow: hidden; }
.mw-img { width: 100%; height: 300rpx; }
.mw-st { position: absolute; top: 14rpx; left: 14rpx; }
.mw-del {
  position: absolute; top: 14rpx; right: 14rpx;
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(23, 20, 15, 0.45);
  display: flex; align-items: center; justify-content: center;
}
.mw-likes {
  position: absolute; left: 16rpx; bottom: 14rpx;
  display: flex; align-items: center; gap: 6rpx;
}
.mw-likes-n { font-size: 22rpx; color: #F6F1E7; text-shadow: 0 1rpx 6rpx rgba(23,20,15,0.6); }
.mw-note { text-align: center; font-size: 20rpx; color: var(--ink-3); letter-spacing: 1rpx; margin-top: 16rpx; }
