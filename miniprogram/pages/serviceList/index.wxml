<view class="page">
  <!-- 搜索 -->
  <view class="srch">
    <icon name="search" size="34rpx" color="#A79E8F" />
    <input class="srch-input" placeholder="搜索商家名称、标签…" placeholder-class="srch-phc" value="{{keyword}}" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearch" />
    <view wx:if="{{keyword}}" class="srch-clear" bindtap="onClearSearch"><icon name="x" size="28rpx" color="#A79E8F" /></view>
  </view>

  <!-- 品类 + 排序 -->
  <scroll-view class="chips-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{categories.length}}">
    <view class="chips-row">
      <view wx:for="{{categories}}" wx:key="_id" class="chip {{categoryType === item.type ? 'on' : ''}}" data-type="{{item.type}}" bindtap="onCategorySwitch">
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="sort-row">
    <text class="text-sm text-hint">共 {{total}} 家</text>
    <view class="sort-ops">
      <text wx:for="{{sortOptions}}" wx:key="key" class="sort-item {{sortBy === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onSortChange">{{item.label}}</text>
    </view>
  </view>

  <!-- 商家大卡 -->
  <view class="plist">
    <view wx:for="{{providers}}" wx:key="_id" class="cd pcard" data-id="{{item._id}}" bindtap="onProviderTap">
      <image wx:if="{{item.backgroundImage}}" src="{{item.backgroundImage}}" mode="aspectFill" class="pcard-cover" />
      <view wx:else class="pcard-cover imph {{item._grad}}"><text class="imph-t" style="font-size:100rpx">{{item._glyph}}</text></view>
      <view class="pcard-body">
        <view class="flex-between">
          <text class="pcard-name serif text-ellipsis">{{item.name}}</text>
          <view class="stars">
            <icon name="star-filled" size="28rpx" color="#C99345" />
            <text class="stars-n serif">{{item.rating || '5.0'}}</text>
          </view>
        </view>
        <view class="pcard-tags" wx:if="{{item._tags.length}}">
          <text class="tag" wx:for="{{item._tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
        </view>
        <view class="pcard-foot">
          <text class="text-sm text-hint">{{item.reviewCount || 0}} 评价 · {{item.orderCount || 0}} 单</text>
          <view class="btn btn-ink btn-sm">预约</view>
        </view>
      </view>
    </view>
    <empty-state wx:if="{{!providers.length}}" text="暂无{{categoryName}}" icon="store" />
  </view>
</view>
