/* ============================================================
   CSS 变量定义 - 文旅摄影预约小程序
   视觉系统 v3「纸墨朱砂 · 新中式」2026-07-21
   上层为新版色板；下层为旧变量别名（旧页面自动过渡，勿删）
   ============================================================ */
page {
  /* ---- 纸墨色板 ---- */
  --paper: #F6F1E7;        /* 宣纸 · 页面底 */
  --paper-2: #FBF8F0;      /* 浅纸 · 吸顶区 / 底栏 */
  --card: #FFFDF7;         /* 卡片 */
  --ink: #29241D;          /* 墨 · 主文字 / 主按钮 */
  --ink-2: #6E675C;        /* 淡墨 · 次文字 */
  --ink-3: #A79E8F;        /* 灰墨 · 弱提示 */
  --line: rgba(41, 36, 29, 0.14);   /* 发丝线 */
  --line-2: rgba(41, 36, 29, 0.07); /* 更浅分隔 */

  /* ---- 强调色（全局仅三种） ---- */
  --red: #BE3F2C;          /* 朱砂 · 价格 / 主操作 / 警示 */
  --red-deep: #9E3020;     /* 深朱 · 按压态 */
  --red-bg: rgba(190, 63, 44, 0.10);
  --celadon: #43615C;      /* 黛青 · 进行中 / 成功 */
  --celadon-bg: rgba(67, 97, 92, 0.13);
  --gold: #B08D57;         /* 泥金 · 评分 / 轻奢点缀 */
  --gold-deep: #8F6B33;
  --gold-bg: rgba(176, 141, 87, 0.16);
  --star: #C99345;         /* 星金 · 评分星 */

  /* ---- 字体 ---- */
  --f-serif: 'Noto Serif SC', 'Songti SC', 'STSong', 'SimSun', 'Noto Serif CJK SC', serif;
  --f-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;

  /* ---- 阴影（仅一种，克制） ---- */
  --shadow-card: 0 2rpx 0 rgba(41, 36, 29, 0.02), 0 28rpx 68rpx -36rpx rgba(41, 36, 29, 0.22);
  --shadow-float: 0 8rpx 32rpx -12rpx rgba(41, 36, 29, 0.28);

  /* ---- 间距 ---- */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* ---- 圆角 ---- */
  --radius-sm: 10rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;
  --radius-round: 50%;

  /* ---- 按钮体系 ---- */
  --btn-height: 88rpx;
  --btn-radius: 999rpx;
  --btn-font-size: 30rpx;

  /* ---- 图标体系 ---- */
  --icon-size-sm: 28rpx;
  --icon-size-md: 36rpx;
  --icon-size-lg: 44rpx;
  --icon-size-xl: 80rpx;

  /* ---- 骨架屏 ---- */
  --skeleton-color: #EDE7DB;
  --skeleton-shimmer: #F6F1E7;

  /* ============================================================
     旧变量别名 —— 让未改版页面自动落入新色板，逐步替换勿删
     ============================================================ */
  --color-primary: var(--ink);
  --color-primary-dark: var(--red-deep);
  --color-primary-light: #E7DFD0;
  --color-primary-bg: #F0EAE0;

  --color-price: var(--red);
  --color-success: var(--celadon);
  --color-warning: var(--gold-deep);
  --color-danger: var(--red);
  --color-info: var(--celadon);

  --text-primary: var(--ink);
  --text-secondary: var(--ink-2);
  --text-hint: var(--ink-3);
  --text-disabled: #C9C2B4;

  --bg-page: var(--paper);
  --bg-white: var(--card);
  --bg-card: var(--card);
  --bg-mask: rgba(23, 20, 15, 0.5);

  --border-color: rgba(41, 36, 29, 0.10);

  /* 旧等级色（评级已删，保留别名防报错） */
  --level-bronze: var(--gold);
  --level-silver: var(--ink-3);
  --level-gold: var(--gold);
  --level-platinum: var(--celadon);
  --level-diamond: var(--celadon);

  /* 旧按钮 padding 别名 */
  --btn-padding: 22rpx 40rpx;
  --icon-color: var(--ink-2);
  --icon-color-light: var(--ink-3);
  --shadow-card-legacy: var(--shadow-card);
}
