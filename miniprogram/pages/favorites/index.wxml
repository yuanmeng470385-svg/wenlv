<view class="page">
  <view class="seg-row">
    <view class="chip {{activeTab === 'provider' ? 'on' : ''}}" data-tab="provider" bindtap="onTabChange">服务商</view>
    <view class="chip {{activeTab === 'portfolio' ? 'on' : ''}}" data-tab="portfolio" bindtap="onTabChange">作品</view>
  </view>

  <empty-state wx:if="{{!list.length}}" text="暂无收藏" icon="bmk" />

  <view wx:for="{{list}}" wx:key="_id" class="cd fav" data-item="{{item}}" bindtap="onItemTap">
    <image wx:if="{{item.detail.image}}" src="{{item.detail.image}}" mode="aspectFill" class="fav-thumb" />
    <view wx:else class="fav-thumb fav-ph">
      <icon wx:if="{{item.targetType === 'provider'}}" name="store" size="44rpx" color="#A79E8F" />
      <icon wx:else name="img" size="44rpx" color="#A79E8F" />
    </view>
    <view class="fav-info">
      <text class="fav-name serif text-ellipsis">{{item.detail.name}}</text>
      <text class="text-sm text-hint text-ellipsis fav-desc">{{item.detail.desc || ''}}</text>
      <view wx:if="{{item.targetType === 'provider'}}" class="stars">
        <icon name="star-filled" size="26rpx" color="#C99345" />
        <text class="stars-n serif">{{item.detail.rating || '5.0'}}</text>
      </view>
    </view>
    <icon name="chevr" size="32rpx" color="#A79E8F" />
  </view>
</view>
