/* ========== 功能页 v3「纸墨朱砂」 ========== */
.page { padding: 0 32rpx 40rpx; min-height: 100vh; }

/* ---- 商家问候 ---- */
.greet { display: flex; align-items: baseline; justify-content: space-between; padding: 20rpx 4rpx 0; }
.greet-l { display: flex; align-items: baseline; }
.greet-t { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; }
.greet-d { font-size: 22rpx; color: var(--ink-3); margin-left: 16rpx; }

/* ---- 数据看板 ---- */
.stat-card { margin-top: 24rpx; padding: 28rpx 0; }

/* ---- 快捷入口 ---- */
.quick { display: flex; margin-top: 20rpx; padding: 28rpx 8rpx; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick-item:active { opacity: 0.75; }
.quick-ic {
  width: 84rpx; height: 84rpx; border-radius: 26rpx;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center;
}
.quick-lb { font-size: 20rpx; color: var(--ink-2); margin-top: 12rpx; }

/* ---- 状态筛选 ---- */
.chips-scroll { width: 100%; margin-top: 24rpx; }
.chips-row { display: flex; padding: 4rpx 32rpx 4rpx 0; }
.chips-row .chip { flex: none; margin-right: 16rpx; }

/* ---- 订单卡 ---- */
.ocard { padding: 28rpx; margin-top: 24rpx; }
.ocard:active { opacity: 0.92; }
.ocard-head { display: flex; align-items: center; justify-content: space-between; }
.ocard-shop { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.ocard-shop-t { font-size: 28rpx; font-weight: 500; }
.ocard-no { margin-top: 18rpx; font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; }
.ocard-line { margin-top: 10rpx; }
.ocard-hr { margin: 20rpx 0; }
.ocard-foot { display: flex; align-items: center; justify-content: space-between; }
.ocard-phone { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 0; }
.ocard-phone-t { font-size: 24rpx; color: var(--celadon); }
.ocard-ops { display: flex; gap: 16rpx; }

/* ---- 管理审核中心 ---- */
.rev-menu { padding: 4rpx 28rpx; }
.rev-menu .lrow { padding: 26rpx 0; }
.rev-ic {
  width: 72rpx; height: 72rpx; border-radius: 20rpx; flex: none;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center; margin-right: 24rpx;
}
