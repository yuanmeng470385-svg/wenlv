/* ========== 档期管理 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }

/* ---- 日期条 ---- */
.sch-scroll { width: 100%; }
.sch-row { display: flex; padding: 8rpx 32rpx 8rpx 0; }
.sch-pill {
  width: 118rpx; flex: none; margin-right: 14rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 0; border-radius: var(--radius-md);
  border: 1rpx solid var(--line); background: var(--card);
}
.sch-pill.on { background: var(--ink); border-color: var(--ink); }
.sch-pill.on .sch-week, .sch-pill.on .sch-day { color: #FBF8F0; }
.sch-week { font-size: 20rpx; color: var(--ink-3); }
.sch-day { font-size: 30rpx; font-weight: 700; color: var(--ink); margin-top: 4rpx; }

.sch-head { margin: 28rpx 0 20rpx; }
.sch-batch { display: flex; gap: 4rpx; }

/* ---- 时段格 ---- */
.slot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.slot {
  width: 31%; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 0; border-radius: var(--radius-md);
  border: 1rpx solid var(--line); background: var(--card);
}
.slot:active { opacity: 0.85; }
.slot-t { font-size: 28rpx; font-weight: 500; color: var(--ink); }
.slot-s { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }
.slot-booked { background: var(--celadon); border-color: var(--celadon); }
.slot-booked .slot-t, .slot-booked .slot-s { color: #F6F1E7; }
.slot-closed { border-style: dashed; opacity: 0.55; }

/* ---- 图例 ---- */
.sch-legend { display: flex; justify-content: center; gap: 32rpx; margin-top: 32rpx; }
.sch-lg-item { display: flex; align-items: center; gap: 8rpx; font-size: 20rpx; color: var(--ink-3); }
.sch-lg-dot { width: 18rpx; height: 18rpx; border-radius: 6rpx; }
.sch-lg-open { border: 1rpx solid var(--line); background: var(--card); }
.sch-lg-booked { background: var(--celadon); }
.sch-lg-closed { border: 1rpx dashed var(--ink-3); }
.sch-tip { text-align: center; font-size: 22rpx; color: var(--ink-3); margin-top: 16rpx; }

.sch-empty { display: flex; flex-direction: column; align-items: center; padding: 140rpx 0; gap: 20rpx; }
.sch-empty-t { font-size: 26rpx; color: var(--ink-3); letter-spacing: 2rpx; }
