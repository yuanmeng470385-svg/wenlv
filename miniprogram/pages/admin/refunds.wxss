/* ========== 退款审核 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.adm-state { text-align: center; padding: 100rpx 0; color: var(--ink-3); font-size: 26rpx; }
.rv-card { padding: 28rpx; margin-top: 20rpx; }
.rv-head-row { display: flex; align-items: center; justify-content: space-between; }
.rv-name { font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.rv-grid { display: grid; grid-template-columns: 140rpx 1fr; row-gap: 12rpx; font-size: 24rpx; }
.rv-k { color: var(--ink-3); }
.rv-v { color: var(--ink); }
.rv-line { margin-top: 12rpx; }
.rv-ops { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rv-rej { flex: 1; }
.rv-pass { flex: 2; }
