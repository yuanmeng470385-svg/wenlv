/* ========== 入驻审核 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.adm-state { text-align: center; padding: 100rpx 0; color: var(--ink-3); font-size: 26rpx; }

.rv-card { padding: 28rpx; margin-top: 20rpx; }
.rv-head { display: flex; align-items: center; }
.rv-avt { width: 96rpx; height: 96rpx; border-radius: 50%; flex: none; margin-right: 24rpx; }
.rv-name-row { display: flex; align-items: center; gap: 12rpx; }
.rv-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; max-width: 300rpx; }
.rv-grid { display: grid; grid-template-columns: 130rpx 1fr; row-gap: 12rpx; font-size: 24rpx; }
.rv-k { color: var(--ink-3); }
.rv-v { color: var(--ink); }
.rv-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.rv-desc { margin-top: 14rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.7; }
.rv-imgs { margin-top: 16rpx; white-space: nowrap; }
.rv-img { width: 160rpx; height: 160rpx; border-radius: var(--radius-md); margin-right: 14rpx; display: inline-block; }
.rv-ops { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rv-rej { flex: 1; }
.rv-pass { flex: 2; }
