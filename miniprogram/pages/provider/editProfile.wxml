<view class="page-edit">
  <view class="form-section card">
    <view class="form-item"><text class="form-label">名称</text><input class="form-input" value="{{name}}" data-field="name" bindinput="onInputChange" /></view>
    <view class="form-item"><text class="form-label">电话</text><input class="form-input" type="number" value="{{phone}}" data-field="phone" bindinput="onInputChange" /></view>
    <view class="form-item"><text class="form-label">简介</text><textarea class="form-textarea" value="{{description}}" data-field="description" bindinput="onInputChange" /></view>
    <view class="form-item"><text class="form-label">特色标签</text><input class="form-input" value="{{featureTags}}" data-field="featureTags" bindinput="onInputChange" placeholder="逗号分隔" /></view>
  </view>
  <view class="p-20"><button class="save-btn" bindtap="onSubmit">保存</button></view>
</view>
