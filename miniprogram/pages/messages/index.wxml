<view class="page-messages">
  <view wx:if="{{unreadCount > 0}}" class="mark-all-bar">
    <text class="text-sm text-secondary">{{unreadCount}} 条未读</text>
    <text class="text-sm text-primary" bindtap="onMarkAllRead">全部已读</text>
  </view>
  <view wx:for="{{messages}}" wx:key="_id" class="msg-card card" data-item="{{item}}" bindtap="onNotificationTap">
    <view class="flex-between">
      <text class="text-bold {{item.read ? '' : 'unread'}}">{{item.title}}</text>
      <text class="text-sm text-hint">{{item.time}}</text>
    </view>
    <text class="text-sm text-secondary mt-10">{{item.content}}</text>
    <view wx:if="{{!item.read}}" class="unread-dot"></view>
  </view>
  <empty-state wx:if="{{!messages.length}}" text="暂无消息" />
</view>
