.page-list { min-height: 100vh; background: #F5F5F5; }
.admin-header-sm { background: linear-gradient(135deg, #1A1A2E, #16213E); padding: 40rpx 30rpx; color: #fff; font-size: 32rpx; font-weight: 700; }
.portfolio-row { padding: 24rpx 30rpx; background: #fff; margin: 0 20rpx 12rpx; border-radius: 12rpx; }
.thumb { width: 100rpx; height: 100rpx; border-radius: 8rpx; }
.thumb.img-ph { width: 100rpx; height: 100rpx; border-radius: 8rpx; font-size: 40rpx; display: flex; align-items: center; justify-content: center; background: #f0f0f0; }
.empty-hint { padding: 120rpx 0; text-align: center; }
.ml-20 { margin-left: 20rpx; }
