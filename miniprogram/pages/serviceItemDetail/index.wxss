/* ========== 套餐详情 v3「纸墨朱砂」 ========== */
.page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ---- 顶部大图 ---- */
.hero {
  width: 100%;
  position: relative;
}
.hero-img {
  width: 100%;
  display: block;
}
.hero-ph {
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-glyph {
  font-size: 160rpx;
  color: rgba(246, 241, 231, 0.55);
  font-family: var(--f-serif);
  font-weight: 900;
}

/* ---- 商家信息 ---- */
.provider-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
  gap: 12rpx;
}
.provider-row:active {
  opacity: 0.7;
}
.pr-name {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}
.pr-cat {
  font-size: 22rpx;
  color: var(--ink-3);
  background: var(--paper-2);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-2);
}

/* ---- 套餐名称 ---- */
.name-row {
  padding: 20rpx 32rpx 0;
}
.s-name {
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--ink);
}

/* ---- 价格 ---- */
.price-row {
  display: flex;
  align-items: baseline;
  padding: 16rpx 32rpx 0;
}
.price-num {
  font-size: 56rpx;
  font-weight: 900;
  color: var(--red);
  font-family: var(--f-serif);
}
.price-sym {
  font-size: 30rpx;
  font-weight: 700;
}
.price-unit {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-left: 6rpx;
}

/* ---- 信息标签 ---- */
.info-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 32rpx 0;
}
.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: var(--paper-2);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--line-2);
}

/* ---- 描述 / 包含内容 ---- */
.sec {
  margin: 32rpx 32rpx 0;
  background: var(--card);
  border-radius: var(--radius-md);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}
.sec-body {
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

/* ---- 包含列表 ---- */
.include-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.include-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.6;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--gold);
  margin-top: 10rpx;
  flex: none;
}

/* ---- 底部固定按钮 ---- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--paper-2);
  border-top: 1rpx solid var(--line-2);
  z-index: 10;
}
.book-btn {
  width: 100%;
  height: 96rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: 34rpx;
  font-weight: 700;
  border-radius: var(--btn-radius);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.book-btn:active {
  background: var(--red-deep);
}
