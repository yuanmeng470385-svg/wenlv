<view class="page-review">
  <view wx:if="{{loading}}" class="empty-hint"><text class="text-secondary">加载中...</text></view>
  <view wx:elif="{{!list.length}}" class="empty-hint"><text class="text-secondary">暂无待审核套餐</text></view>
  <view wx:for="{{list}}" wx:key="_id" class="review-card card">
    <text class="text-bold text-lg">{{item.name}}</text>
    <text class="text-sm text-secondary mt-10">服务商: {{item.providerName}} | {{getTypeLabel(item.priceType)}}</text>
    <view class="flex-between mt-10">
      <text class="text-price text-lg">¥{{item.price/100}}</text>
      <text class="text-sm text-secondary">⏱ {{item.duration}}分钟</text>
    </view>
    <text class="text-sm text-secondary mt-10">{{item.description}}</text>
    <view class="action-btns mt-20">
      <button class="btn-reject" data-id="{{item._id}}" data-action="rejected" bindtap="onAction">驳回</button>
      <button class="btn-pass" data-id="{{item._id}}" data-action="approved" bindtap="onAction">通过</button>
    </view>
  </view>
</view>
