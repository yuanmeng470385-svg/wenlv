.page-schedule { min-height: 100vh; background: var(--bg-page); }
.date-bar { background: var(--bg-white); padding: 16rpx 20rpx; white-space: nowrap; }
.date-item { display: inline-block; padding: 14rpx 28rpx; font-size: 26rpx; border-radius: 30rpx; margin-right: 12rpx; border: 1rpx solid var(--border-color); color: var(--text-secondary); }
.date-item.active { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-bg); font-weight: 600; }

.slot-section { padding: 20rpx; }
.batch-btns { display: flex; gap: 12rpx; }
.batch-btn { padding: 10rpx 20rpx; font-size: 24rpx; border-radius: 24rpx; }
.batch-btn.on { background: #F2F9ED; color: var(--color-success); border: 1rpx solid var(--color-success); }
.batch-btn.off { background: #FDF0F0; color: var(--color-danger); border: 1rpx solid var(--color-danger); }

.slot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.slot-card { width: calc(50% - 8rpx); padding: 28rpx 20rpx; border-radius: 16rpx; text-align: center; }
.slot-card.open { background: var(--color-primary-bg); border: 2rpx solid var(--color-primary); }
.slot-card.closed { background: var(--bg-page); border: 2rpx solid var(--border-color); }
.slot-time { display: block; font-size: 36rpx; font-weight: 700; color: var(--text-primary); }
.slot-status { display: block; font-size: 24rpx; margin-top: 6rpx; }
.slot-card.open .slot-status { color: var(--color-success); }
.slot-card.closed .slot-status { color: var(--text-hint); }

.p-20 { padding: 20rpx; display: flex; }
.empty-hint { padding: 120rpx 0; text-align: center; }
