/* ========== 商家仪表盘 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.pd-stat { padding: 28rpx 0; }
.quick { display: flex; margin-top: 20rpx; padding: 28rpx 8rpx; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.quick-item:active { opacity: 0.75; }
.quick-ic {
  width: 84rpx; height: 84rpx; border-radius: 26rpx;
  background: var(--paper-2); border: 1rpx solid var(--line-2);
  display: flex; align-items: center; justify-content: center;
}
.quick-lb { font-size: 20rpx; color: var(--ink-2); margin-top: 12rpx; }
.pd-orders { margin-top: 24rpx; padding: 28rpx 28rpx 8rpx; }
.pd-orders .lrow { padding: 22rpx 0; }
