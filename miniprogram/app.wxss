@import './styles/reset.wxss';
@import './styles/variables.wxss';

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  line-height: 1.6;
}

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

.text-center { text-align: center; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-bold { font-weight: 700; }

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--text-secondary); }
.text-hint { color: var(--text-hint); }
.text-price { color: var(--color-price); }
.text-success { color: var(--color-success); }
.text-danger { color: var(--color-danger); }

.card {
  background: var(--bg-white);
  border-radius: var(--radius-md);
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 图片占位 */
.img-ph {
  background: linear-gradient(135deg, var(--color-primary-bg), var(--color-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--color-primary);
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: var(--radius-sm);
}
.tag-primary { background: var(--color-primary-bg); color: var(--color-primary); }
.tag-success { background: #F0F8EB; color: var(--color-success); }
.tag-danger  { background: #FDF0F0; color: var(--color-danger); }
.tag-warning { background: #FDF6EB; color: var(--color-warning); }
.tag-info    { background: #EEF4FC; color: var(--color-info); }

/* 图标 + 文字行 */
.icon-row { display: flex; align-items: center; gap: 4rpx; }
.icon-row-wide { display: flex; align-items: center; gap: 8rpx; }

/* 按钮统一体系 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--btn-height);
  padding: 0 var(--spacing-lg);
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--btn-radius);
  font-size: var(--btn-font-size);
  font-weight: 600;
}
.btn-primary:active { opacity: 0.85; }

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--btn-height);
  padding: 0 var(--spacing-lg);
  background: var(--bg-white);
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: var(--btn-radius);
  font-size: var(--btn-font-size);
}
.btn-outline:active { background: var(--bg-page); }

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--btn-height);
  padding: 0 var(--spacing-lg);
  background: var(--color-danger);
  color: #fff;
  border: none;
  border-radius: var(--btn-radius);
  font-size: var(--btn-font-size);
  font-weight: 600;
}
.btn-danger:active { opacity: 0.85; }

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
}

/* 状态文字 */
.status-success { color: var(--color-success); }
.status-danger  { color: var(--color-danger); }
.status-warning { color: var(--color-warning); }

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-hint);
  font-size: 28rpx;
}
