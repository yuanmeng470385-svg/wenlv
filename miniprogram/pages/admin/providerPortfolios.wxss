.page-list { min-height: 100vh; background: var(--bg-page); }
.admin-header-sm { background: linear-gradient(135deg, #2D1B69, #1A0F3C); padding: 40rpx 30rpx; color: #fff; font-size: 32rpx; font-weight: 700; }
.portfolio-row { padding: 24rpx 30rpx; background: var(--bg-white); margin: 0 20rpx 12rpx; border-radius: 12rpx; }
.thumb { width: 100rpx; height: 100rpx; border-radius: 8rpx; }
.thumb.img-ph { width: 100rpx; height: 100rpx; border-radius: 8rpx; font-size: 40rpx; display: flex; align-items: center; justify-content: center; background: var(--bg-page); }
.empty-hint { padding: 120rpx 0; text-align: center; }
.ml-20 { margin-left: 20rpx; }
.icon-row { display: flex; align-items: center; gap: 8rpx; }
