/* ========== 精选作品管理 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.pp-head { margin-bottom: 8rpx; }
.pp-row { display: flex; align-items: center; padding: 20rpx 24rpx; margin-top: 16rpx; }
.pp-thumb { width: 110rpx; height: 110rpx; border-radius: var(--radius-md); flex: none; margin-right: 24rpx; }
.pp-ph { background: var(--paper-2); border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; }
.pp-title { font-size: 28rpx; font-weight: 500; display: block; max-width: 360rpx; }
.pp-likes { display: flex; align-items: center; gap: 6rpx; margin-top: 8rpx; }
