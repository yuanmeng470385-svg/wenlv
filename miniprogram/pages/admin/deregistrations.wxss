/* ========== 注销审核 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.rv-card { padding: 28rpx; margin-top: 20rpx; }
.rv-head-row { display: flex; align-items: center; justify-content: space-between; }
.rv-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; }
.rv-grid { display: grid; grid-template-columns: 160rpx 1fr; row-gap: 12rpx; font-size: 24rpx; }
.rv-k { color: var(--ink-3); }
.rv-v { color: var(--ink); }
.dg-warn { color: var(--red); font-weight: 500; }
.dg-ok { color: var(--celadon); }
.dg-note {
  margin-top: 20rpx; padding: 16rpx 20rpx;
  background: rgba(190, 63, 44, 0.06); border: 1rpx solid rgba(190, 63, 44, 0.16);
  border-radius: var(--radius-md); font-size: 20rpx; color: var(--red); line-height: 1.7;
}
.rv-ops { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rv-rej { flex: 1; }
.rv-pass { flex: 2; }
