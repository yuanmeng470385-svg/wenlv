<view class="page-works">
  <view wx:for="{{works}}" wx:key="_id" class="work-card card">
    <image src="{{item.images[0]}}" mode="aspectFill" class="work-thumb" />
    <view class="work-info flex-1">
      <text class="text-bold">{{item.title}}</text>
      <text class="text-sm text-secondary">状态: {{item.status}}</text>
      <view class="icon-row"><icon name="heart-filled" size="24rpx" /><text class="text-sm text-secondary">{{item.likeCount || 0}}</text></view>
    </view>
    <text class="del-btn text-price" data-id="{{item._id}}" bindtap="onDelete">删除</text>
  </view>
  <view wx:if="{{!works.length}}" class="empty-hint"><text class="text-secondary">暂无作品，去上传吧</text></view>
</view>
