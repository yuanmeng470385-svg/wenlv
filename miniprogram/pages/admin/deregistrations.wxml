<view class="page">
  <empty-state wx:if="{{!list.length}}" text="暂无待审核注销申请" icon="trash" />

  <view wx:for="{{list}}" wx:key="_id" class="cd rv-card" data-id="{{item._id}}" bindtap="onCardTap">
    <view class="rv-head-row">
      <text class="rv-name serif">{{item.name}}</text>
      <text class="tag">{{item.categoryType === 'photographer' ? '摄影师' : (item.categoryType === 'makeup' ? '妆造师' : '汉服店')}}</text>
    </view>
    <view class="rv-grid" style="margin-top:16rpx">
      <text class="rv-k">联系电话</text><text class="rv-v">{{item.phone}}</text>
      <text class="rv-k">总订单</text><text class="rv-v">{{item.totalOrders}}</text>
      <text class="rv-k">未完成订单</text>
      <text class="rv-v {{item.unfinishedOrders > 0 ? 'dg-warn' : 'dg-ok'}}">{{item.unfinishedOrders}}{{item.unfinishedOrders > 0 ? '（建议先处理）' : ''}}</text>
      <text class="rv-k">申请时间</text><text class="rv-v">{{item.updateTime}}</text>
    </view>
    <view class="dg-note">同意后将删除店铺、作品、套餐与评价，历史订单保留并标记「商家已注销」</view>
    <view class="rv-ops">
      <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" catchtap="onReject">拒绝</button>
      <button class="btn btn-red btn-md rv-pass" data-id="{{item._id}}" catchtap="onApprove">同意注销</button>
    </view>
  </view>
</view>
