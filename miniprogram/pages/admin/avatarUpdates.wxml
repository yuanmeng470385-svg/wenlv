<view class="page">
  <empty-state wx:if="{{!list.length}}" text="暂无待审核申请" icon="camera" />

  <view wx:for="{{list}}" wx:key="_id" class="cd rv-card" data-id="{{item._id}}" bindtap="onCardTap">
    <view class="rv-head-row">
      <text class="rv-name serif">{{item.name}}</text>
      <text class="tag">{{item.categoryType === 'photographer' ? '摄影师' : (item.categoryType === 'makeup' ? '妆造师' : '汉服店')}}</text>
    </view>

    <!-- 头像变更 -->
    <view wx:if="{{item.pendingAvatar}}" class="cmp">
      <view class="text-sm text-hint" style="margin-bottom:16rpx">申请更换头像 · {{item.createTime}}</view>
      <view class="cmp-row">
        <view class="cmp-col">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="cmp-avt cmp-old" data-url="{{item.avatar}}" catchtap="previewImage" />
          <view wx:else class="cmp-avt cmp-old cmp-none">无</view>
          <text class="cmp-lb">当前头像</text>
        </view>
        <icon name="chevr" size="44rpx" color="#A79E8F" />
        <view class="cmp-col">
          <image src="{{item.pendingAvatar}}" mode="aspectFill" class="cmp-avt cmp-new" data-url="{{item.pendingAvatar}}" catchtap="previewImage" />
          <text class="cmp-lb cmp-lb-new">申请新头像</text>
        </view>
      </view>
      <view class="rv-ops">
        <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" data-field="avatar" catchtap="onReject">拒绝</button>
        <button class="btn btn-ink btn-md rv-pass" data-id="{{item._id}}" data-field="avatar" catchtap="onApprove">通过并替换</button>
      </view>
    </view>

    <!-- 背景图变更 -->
    <view wx:if="{{item.pendingBackgroundImage}}" class="cmp">
      <view class="text-sm text-hint" style="margin-bottom:16rpx">申请更换背景图 · {{item.createTime}}</view>
      <image wx:if="{{item.backgroundImage}}" src="{{item.backgroundImage}}" mode="aspectFill" class="cmp-bg cmp-old" data-url="{{item.backgroundImage}}" catchtap="previewImage" />
      <view wx:else class="cmp-bg cmp-old cmp-none">无</view>
      <view class="cmp-arrow"><icon name="chevr" size="36rpx" color="#A79E8F" /></view>
      <image src="{{item.pendingBackgroundImage}}" mode="aspectFill" class="cmp-bg cmp-new" data-url="{{item.pendingBackgroundImage}}" catchtap="previewImage" />
      <view class="rv-ops">
        <button class="btn btn-line-red btn-md rv-rej" data-id="{{item._id}}" data-field="backgroundImage" catchtap="onReject">拒绝</button>
        <button class="btn btn-ink btn-md rv-pass" data-id="{{item._id}}" data-field="backgroundImage" catchtap="onApprove">通过并替换</button>
      </view>
    </view>
  </view>
</view>
