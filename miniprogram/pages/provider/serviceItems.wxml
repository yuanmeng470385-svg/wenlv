<view class="page">
  <!-- 顶部 -->
  <view class="si-top">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">我的套餐 ({{items.length}})</view>
      <view class="sech-line"></view>
      <view class="btn btn-ink btn-sm" bindtap="goAdd"><icon name="plus" size="26rpx" color="#FBF8F0" />&nbsp;新建</view>
    </view>
  </view>

  <!-- 审核提示 -->
  <view class="si-hint">
    <icon name="bell" size="28rpx" color="#8F6B33" />
    <text class="si-hint-t">新增 / 修改套餐需管理员审核后上架</text>
  </view>

  <!-- 套餐卡 -->
  <view wx:for="{{items}}" wx:key="_id" class="cd si-card {{item.status === 'rejected' ? 'si-card-rej' : ''}}">
    <view class="si-main">
      <image wx:if="{{item.icon}}" class="si-ic" src="{{item.icon}}" mode="aspectFill" />
      <view wx:else class="si-ic si-ic-ph"><icon name="order" size="40rpx" color="#43615C" /></view>
      <view class="flex-1">
        <view class="si-name-row">
          <text class="si-name text-ellipsis">{{item.name}}</text>
          <text class="st {{item._statusClass}}">{{item._statusLabel}}</text>
        </view>
        <view class="si-meta">
          <text class="price" style="font-size:30rpx"><text class="price-sym">¥</text>{{item.price/100}}<text class="price-q" wx:if="{{item.priceType === 'hourly'}}">/时</text></text>
          <text class="si-meta-t"> · {{item.duration}}分钟 · 每日限 {{item.maxDailyBooking || 5}} 单</text>
        </view>
        <view wx:if="{{item.status === 'rejected' && item.reviewRemark}}" class="si-rej">驳回原因：{{item.reviewRemark}}</view>
      </view>
      <switch wx:if="{{item._canToggle}}" checked="{{item._isOn}}" color="#29241D" data-item="{{item}}" bindchange="onToggleStatus" style="transform:scale(0.85)" />
    </view>
    <view class="hr si-hr"></view>
    <view class="si-ops">
      <view wx:if="{{item.status === 'pending_review'}}" class="text-hint" style="font-size:20rpx">审核期间不可上下架</view>
      <view wx:elif="{{item.status === 'rejected'}}" class="btn btn-ink btn-sm" data-item="{{item}}" catchtap="goEdit">修改并重审</view>
      <view wx:else></view>
      <view class="si-ops-r">
        <view class="btn btn-txt-ink btn-sm" data-item="{{item}}" catchtap="goEdit"><icon name="pen" size="26rpx" color="#6E675C" /> 编辑</view>
        <view class="btn btn-txt btn-sm" data-id="{{item._id}}" catchtap="onDelete"><icon name="trash" size="26rpx" color="#BE3F2C" /> 删除</view>
      </view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && !items.length}}" text="还没有套餐，点击右上角新建" icon="order" />
</view>
