<view class="page">
  <!-- 数据 -->
  <view class="cd stat pd-stat">
    <view class="stat-cell">
      <view class="stat-n" style="color:#BE3F2C">{{stats.todayOrders}}</view>
      <view class="stat-l">今日订单</view>
    </view>
    <view class="stat-cell">
      <view class="stat-n" style="color:#8F6B33">{{stats.pendingOrders}}</view>
      <view class="stat-l">待处理</view>
    </view>
    <view class="stat-cell">
      <view class="stat-n">{{stats.totalOrders}}</view>
      <view class="stat-l">总订单</view>
    </view>
    <view class="stat-cell">
      <view class="stat-n" style="font-size:36rpx">¥{{stats.totalIncome}}</view>
      <view class="stat-l">总收入</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="cd quick">
    <view class="quick-item" bindtap="goUploadWork">
      <view class="quick-ic quick-ic-red"><icon name="upload" size="40rpx" color="#BE3F2C" /></view>
      <text class="quick-lb">上传作品</text>
    </view>
    <view class="quick-item" bindtap="goMyWorks">
      <view class="quick-ic"><icon name="img" size="40rpx" color="#43615C" /></view>
      <text class="quick-lb">作品管理</text>
    </view>
    <view class="quick-item" bindtap="goSchedule">
      <view class="quick-ic"><icon name="cal" size="40rpx" color="#43615C" /></view>
      <text class="quick-lb">档期管理</text>
    </view>
    <view class="quick-item" bindtap="goEditProfile">
      <view class="quick-ic"><icon name="pen" size="40rpx" color="#43615C" /></view>
      <text class="quick-lb">编辑资料</text>
    </view>
  </view>

  <!-- 最近订单 -->
  <view class="cd pd-orders">
    <view class="sech">
      <view class="sech-sq"></view><view class="sech-t" style="font-size:30rpx">最近订单</view>
      <view class="sech-line"></view>
    </view>
    <view wx:for="{{recentOrders}}" wx:key="_id" class="lrow" data-id="{{item._id}}" bindtap="goOrderDetail">
      <view class="lrow-t serif" style="font-weight:700">{{item.orderNo}}</view>
      <view class="price" style="font-size:28rpx"><text class="price-sym">¥</text>{{item.totalFee / 100}}</view>
    </view>
    <empty-state wx:if="{{!recentOrders.length}}" text="暂无订单" icon="order" />
  </view>
</view>
