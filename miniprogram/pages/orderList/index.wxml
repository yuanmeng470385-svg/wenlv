<view class="page-orders">
  <block wx:if="{{isAdminMode}}">
    <view class="admin-review-center">
      <view class="admin-header-sm">📋 审核中心</view>
      <view class="review-menu">
        <view class="review-menu-item flex-between" bindtap="goAdminProviders"><text>🏪 服务商入驻</text><text class="text-secondary">></text></view>
        <view class="review-menu-item flex-between" bindtap="goAdminPortfolios"><text>🖼️ 作品审核</text><text class="text-secondary">></text></view>
        <view class="review-menu-item flex-between" bindtap="goAdminServiceItems"><text>📦 套餐审核</text><text class="text-secondary">></text></view>
        <view class="review-menu-item flex-between" bindtap="goAdminRefunds"><text>💰 退款审核</text><text class="text-secondary">></text></view>
        <view class="review-menu-item flex-between" bindtap="goAdminAvatarUpdates"><text>🖼️ 头像/背景审核</text><text class="text-secondary">></text></view>
        <view class="review-menu-item flex-between" bindtap="goAdminDeregistrations"><text>⚠️ 注销审核</text><text class="text-secondary">></text></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{!isAdminMode}}">
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-list">
      <view wx:for="{{activeRole === 'user' ? userTabs : providerTabs}}" wx:key="key"
        class="tab-item {{currentTab === item.key ? 'active' : ''}}"
        data-tab="{{item.key}}" bindtap="onTabChange">
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <block wx:if="{{activeRole === 'user'}}">
    <view wx:for="{{orders}}" wx:key="_id" class="order-card card" data-id="{{item._id}}" bindtap="onOrderTap">
      <view class="flex-between mb-20"><text class="text-sm text-bold">{{item.orderNo}}</text><text class="text-sm text-primary">{{item.statusText}}</text></view>
      <view wx:for="{{item.items}}" wx:key="serviceItemId" wx:for-item="si" class="order-item">
        <text>{{si.name}}<text wx:if="{{si.providerDeleted}}" class="text-sm text-hint">(商家已注销)</text></text>
        <text class="text-sm text-secondary">{{si.appointmentDate}} {{si.appointmentTime}}</text>
      </view>
      <view class="flex-between mt-20 pt-20"><text class="text-price text-lg">¥{{item.totalFee/100}}</text></view>
    </view>
  </block>

  <block wx:else>
    <view class="dash-top">
      <view class="stats-row">
        <view class="stat-card"><text class="stat-num">{{dashboard.todayOrders}}</text><text class="stat-label">今日预约</text></view>
        <view class="stat-card"><text class="stat-num highlight">{{dashboard.pendingOrders}}</text><text class="stat-label">待处理</text></view>
        <view class="stat-card"><text class="stat-num">{{dashboard.totalOrders}}</text><text class="stat-label">总订单</text></view>
      </view>
      <view class="quick-row">
        <view class="quick-item" bindtap="goUploadWork"><text class="quick-icon">📤</text><text class="quick-label">上传作品</text></view>
        <view class="quick-item" bindtap="goMyWorks"><text class="quick-icon">🖼️</text><text class="quick-label">作品管理</text></view>
        <view class="quick-item" bindtap="goServiceItems"><text class="quick-icon">📦</text><text class="quick-label">套餐管理</text></view>
        <view class="quick-item" bindtap="goSchedule"><text class="quick-icon">📅</text><text class="quick-label">档期管理</text></view>
        <view class="quick-item" bindtap="goEditProfile"><text class="quick-icon">✏️</text><text class="quick-label">编辑资料</text></view>
      </view>
    </view>

    <view wx:for="{{orders}}" wx:key="_id" class="order-card card" data-id="{{item._id}}" bindtap="onOrderTap">
      <view class="flex-between mb-20">
        <text class="text-sm text-bold">{{item.orderNo}}</text>
        <text class="status-text text-sm">{{item.statusText}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:key="serviceItemId" wx:for-item="si">
        <view class="flex-between mb-10"><text class="text-bold">{{si.name}}</text><text class="text-price">¥{{si.price/100}}</text></view>
        <text class="text-sm text-secondary">{{si.appointmentDate}} {{si.appointmentTime}}</text>
      </view>
      <view class="flex-row mt-10">
        <text class="text-sm text-secondary">{{item.contactName}} {{item.contactPhone}}</text>
        <text class="call-icon ml-10" catchtap="onCallCustomer" data-id="{{item._id}}">📞</text>
      </view>
      <view class="action-btns mt-20">
        <button wx:if="{{item.orderStatus === 'paid'}}" class="btn-refuse" data-id="{{item._id}}" data-action="reject" catchtap="onProviderAction">拒绝</button>
        <button wx:if="{{item.orderStatus === 'paid'}}" class="btn-confirm" data-id="{{item._id}}" data-action="confirm" catchtap="onProviderAction">确认接单</button>
        <button wx:if="{{item.orderStatus === 'confirmed'}}" class="btn-confirm" data-id="{{item._id}}" data-action="start" catchtap="onProviderAction">开始服务</button>
        <button wx:if="{{item.orderStatus === 'in_progress'}}" class="btn-confirm" data-id="{{item._id}}" data-action="complete" catchtap="onProviderAction">完成服务</button>
      </view>
    </view>
  </block>

  <view wx:if="{{!orders.length}}" class="empty-hint"><text class="text-secondary">暂无订单</text></view>
  </block>
</view>
