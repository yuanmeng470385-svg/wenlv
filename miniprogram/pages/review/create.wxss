.page-review { min-height: 100vh; background: var(--bg-page); padding: 20rpx; }
.rating-section { margin: 0 0 20rpx; }
.star-row { display: flex; gap: 16rpx; }
.star { font-size: 56rpx; opacity: 0.3; }
.star.active { opacity: 1; }
.content-section { margin: 0 0 20rpx; }
.review-textarea { width: 100%; height: 200rpx; font-size: 28rpx; }
.submit-btn { width: 100%; height: 88rpx; background: var(--color-primary); color: #fff; border-radius: 44rpx; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
.p-20 { padding: 20rpx; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.text-right { text-align: right; }
.icon-row { display: flex; align-items: center; gap: 4rpx; }
