/* ========== 评价 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.rv-order { padding: 28rpx; }
.rv-no { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.rv-line { margin-top: 10rpx; }
.rv-sec { margin-top: 24rpx; padding: 28rpx; }
.rv-score { font-size: 34rpx; font-weight: 900; color: var(--star); }
.rv-stars { display: flex; justify-content: center; gap: 24rpx; padding: 32rpx 0 12rpx; }
.rv-star { padding: 8rpx; }
.rv-ta { width: 100%; height: 220rpx; margin-top: 20rpx; font-size: 28rpx; line-height: 1.7; box-sizing: border-box; }
.rv-ph { color: var(--ink-3); }
.rv-submit { margin-top: 40rpx; }
