/* ========== 作品审核 v3「纸墨朱砂」 ========== */
.page { padding: 16rpx 32rpx 40rpx; min-height: 100vh; }
.adm-state { text-align: center; padding: 100rpx 0; color: var(--ink-3); font-size: 26rpx; }
.rv-card { padding: 28rpx; margin-top: 20rpx; }
.rv-head { display: flex; align-items: flex-start; }
.rv-thumb { width: 140rpx; height: 140rpx; border-radius: var(--radius-md); flex: none; margin-right: 24rpx; }
.rv-thumb-ph { background: var(--paper-2); border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; }
.rv-name { font-size: 32rpx; font-weight: 700; letter-spacing: 1rpx; }
.rv-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.rv-desc { margin-top: 16rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.7; }
.rv-ops { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rv-rej { flex: 1; }
.rv-pass { flex: 2; }
