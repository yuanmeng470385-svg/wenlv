.page-review { min-height: 100vh; background: var(--bg-page); padding: 20rpx; }
.review-card { margin: 0 0 16rpx; }
.action-btns { display: flex; justify-content: flex-end; gap: 12rpx; }
.btn-pass { padding: 14rpx 40rpx; font-size: 26rpx; background: var(--color-success); color: #fff; border-radius: 30rpx; }
.btn-reject { padding: 14rpx 40rpx; font-size: 26rpx; background: var(--bg-page); color: var(--text-hint); border-radius: 30rpx; }
.empty-hint { padding: 120rpx 0; text-align: center; }
.mt-10 { margin-top: 10rpx; } .mt-20 { margin-top: 20rpx; }
.icon-row { display: flex; align-items: center; gap: 8rpx; }
