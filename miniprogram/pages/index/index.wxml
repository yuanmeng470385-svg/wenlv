<!-- 管理员模式 -->
<block wx:if="{{isAdminMode}}">
<view class="page-admin">
  <view class="admin-header">管理中心</view>

  <!-- Banner管理 -->
  <view class="section card">
    <view class="section-header flex-between">
      <text class="text-bold text-lg">顶部Banner</text>
      <text class="text-sm text-primary" bindtap="onAddBanner">+ 新增</text>
    </view>
    <view wx:for="{{adminBanners}}" wx:key="_id" class="banner-row">
      <view class="flex-row">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="banner-thumb" data-url="{{item.image}}" bindtap="previewBannerImage" />
        <view wx:else class="banner-thumb banner-thumb-ph" data-id="{{item._id}}" bindtap="onBannerImage">+图片</view>
        <view class="flex-1 ml-20">
          <text class="text-bold">{{item.title}}</text>
          <text wx:if="{{item.image}}" class="text-sm text-primary" data-id="{{item._id}}" bindtap="onBannerImage">更换图片</text>
        </view>
      </view>
      <view class="flex-row mt-10">
        <text class="text-sm text-primary mr-20" data-id="{{item._id}}" data-title="{{item.title}}" bindtap="onEditBanner">改标题</text>
        <text class="text-sm text-price" data-id="{{item._id}}" bindtap="onDeleteBanner">删除</text>
      </view>
    </view>
  </view>

  <!-- 精选商家管理 -->
  <view class="section card mt-20">
    <view class="section-header">
      <text class="text-bold text-lg">优秀展示管理</text>
      <text class="text-sm text-secondary">点击进入管理该商家的作品</text>
    </view>
    <view wx:for="{{allProviders}}" wx:key="_id" class="featured-row flex-between" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="goManagePortfolios">
      <text>{{item.name}}</text>
      <text class="text-sm text-primary">管理作品 ></text>
    </view>
  </view>
</view>
</block>

<!-- 用户模式 -->
<block wx:elif="{{activeRole === 'user'}}">
<view class="page-index">
  <swiper wx:if="{{banners.length}}" class="banner-swiper" indicator-dots autoplay circular>
    <swiper-item wx:for="{{banners}}" wx:key="_id">
      <view class="banner-item">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="banner-img" />
        <text class="banner-title">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <view class="category-section">
    <view class="category-grid">
      <view class="category-item" wx:for="{{categories}}" wx:key="_id" data-type="{{item.type}}" bindtap="onCategoryTap">
        <view class="category-icon-box">
          <image class="category-icon-img" mode="aspectFit" src="/images/icons/category-{{item.type}}.png" />
        </view>
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-header flex-between">
      <text class="text-lg text-bold">优秀展示</text>
    </view>
    <empty-state wx:if="{{!featuredWorks.length}}" text="暂无精选作品" icon="photo" />
    <view class="featured-grid" wx:else>
      <view class="featured-item" wx:for="{{featuredWorks}}" wx:key="_id" data-id="{{item.providerId}}" bindtap="onProviderTap">
        <view class="featured-item-inner">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="featured-img" />
          <view wx:else class="featured-img img-ph">{{item.categoryEmoji}}</view>
          <view class="featured-info">
            <image wx:if="{{item.providerAvatar}}" src="{{item.providerAvatar}}" mode="aspectFill" class="featured-avatar" />
            <view wx:else class="featured-avatar img-ph-sm">{{item.categoryEmoji}}</view>
            <text class="featured-name text-ellipsis">{{item.providerName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
</block>

<!-- 商家模式 - 自己的店铺详情页 -->
<block wx:else>
<view class="page-detail" wx:if="{{provider}}">
  <view class="cover-section">
    <image class="cover-img" src="{{provider.backgroundImage}}" mode="aspectFill" />
    <view class="cover-edit-btn" bindtap="onEditBackground">
      <text class="edit-icon">更换背景</text>
    </view>
  </view>

  <view class="p-info p-30">
    <view class="flex-row">
      <view class="avatar-wrap">
        <image class="p-avatar" src="{{provider.avatar}}" mode="aspectFill" />
        <view class="avatar-edit-btn" bindtap="onEditAvatar">
          <text class="edit-icon-sm">+</text>
        </view>
      </view>
      <view class="flex-1 ml-20">
        <text class="text-xl text-bold">{{provider.name}}</text>
        <view wx:if="{{provider.rating}}" class="flex-row mt-10">
          <view class="icon-row mr-10"><icon name="star-filled" size="28rpx" /><text class="text-price text-bold">{{provider.rating}}</text></view>
          <text class="text-sm text-hint">({{provider.reviewCount}}条评价)</text>
        </view>
      </view>
    </view>
    <view wx:if="{{provider.featureTags}}" class="tag-row mt-20">
      <text wx:for="{{provider.featureTags}}" wx:key="*this" class="feature-tag">{{item}}</text>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{activeTab==='service'?'active':''}}" data-tab="service" bindtap="onTabChange"><text>服务项目</text></view>
    <view class="tab-item {{activeTab==='works'?'active':''}}" data-tab="works" bindtap="onTabChange"><text>作品展示</text></view>
    <view class="tab-item {{activeTab==='reviews'?'active':''}}" data-tab="reviews" bindtap="onTabChange"><text>用户评价</text></view>
  </view>

  <view wx:if="{{activeTab==='service'}}" class="tab-content">
    <view wx:for="{{serviceItems}}" wx:key="_id" class="service-card card">
      <image wx:if="{{item.icon}}" class="s-cover" src="{{item.icon}}" mode="aspectFill" />
      <view wx:else class="s-cover s-cover-ph">{{provider._categoryEmoji}}</view>
      <view class="s-info">
        <text class="text-lg text-bold">{{item.name}}</text>
        <text class="text-sm text-secondary mt-10">{{item.description}}</text>
        <view class="flex-between mt-10">
          <text class="text-price text-lg">¥{{item.price/100}}</text>
          <text class="text-sm text-secondary">时长 {{item.duration}}分钟</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab==='works'}}" class="tab-content">
    <view class="work-grid">
      <view wx:for="{{portfolios}}" wx:key="_id" class="work-item">
        <image src="{{item.images[0]}}" mode="aspectFill" class="work-img" />
        <view class="work-overlay">
          <text class="work-title text-ellipsis">{{item.title}}</text>
          <view class="icon-row"><icon name="heart-filled" size="28rpx" /><text class="text-sm">{{item.likeCount || 0}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab==='reviews'}}" class="tab-content">
    <view wx:for="{{reviews}}" wx:key="_id" class="review-card card">
      <view class="flex-between">
        <view class="icon-row"><icon name="star-filled" size="28rpx" /><text class="text-sm text-price">{{item.rating}}</text></view>
        <text class="text-sm text-hint">{{item.createTime}}</text>
      </view>
      <text class="mt-10">{{item.content}}</text>
    </view>
  </view>
</view>
</block>
